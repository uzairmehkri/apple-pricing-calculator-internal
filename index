function calcGstWith() {
  const v = parseFloat(document.getElementById('gst-with').value);
  const el = document.getElementById('gst-without-result');
  el.textContent = !isNaN(v) && v > 0 ? fmt(Math.round(v / 1.18 * 100) / 100) : '—';
}

function calcGstWithout() {
  const v = parseFloat(document.getElementById('gst-without').value);
  const el = document.getElementById('gst-with-result');
  el.textContent = !isNaN(v) && v > 0 ? fmt(Math.round(v * 1.18 * 100) / 100) : '—';
}

