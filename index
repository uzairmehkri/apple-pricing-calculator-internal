  btn.classList.add('active');
  calculateChecker();
}

function getBase(basis) {
  if (basis === 'prog') return currentProgItp;
  return currentItp;
}

function onMarginPctInput() {
  // Bug fix: the previous code referenced a non-existent 'margin-sell' input which
  // threw a TypeError and prevented calculateMarginBuilder() from ever running.
  document.getElementById('margin-amt').value = '';
  calculateMarginBuilder();
}

function onMarginAmtInput() {
  // Bug fix: removed non-existent 'margin-sell' input reference (was crashing).
  document.getElementById('margin-pct').value = '';
  calculateMarginBuilder();
}

function calculateMarginBuilder() {
  // Bug fix: removed parseFloat on non-existent 'margin-sell' input which threw a TypeError.
  const base = getBase(marginBasis);
  const pctInput = parseFloat(document.getElementById('margin-pct').value);
  const amtInput = parseFloat(document.getElementById('margin-amt').value);

  const setMb = (id, val, cls) => {
    const el = document.getElementById(id);
    el.textContent = val;
    el.className = 'margin-result-val' + (cls ? ' ' + cls : '');
  };

  if (!base) {
    setMb('mb-selling-price', '—'); setMb('mb-margin-amt', '—'); setMb('mb-margin-pct', '—');
    return;
  }

  let sellingPrice, marginAmt, marginPct;

  if (!isNaN(pctInput)) {
    marginAmt    = base * (pctInput / 100);
    sellingPrice = base + marginAmt;
    marginPct    = pctInput;
  } else if (!isNaN(amtInput)) {
    marginAmt    = amtInput;
    sellingPrice = base + amtInput;
    marginPct    = (amtInput / base) * 100;
  } else {
    setMb('mb-selling-price', '—'); setMb('mb-margin-amt', '—'); setMb('mb-margin-pct', '—');
    return;
  }

  const cls = marginAmt >= 0 ? 'positive' : 'negative';
  setMb('mb-selling-price', fmt(sellingPrice));
  setMb('mb-margin-amt',    (marginAmt >= 0 ? '+' : '') + fmt(marginAmt), cls);
  setMb('mb-margin-pct',    (marginPct >= 0 ? '+' : '') + marginPct.toFixed(2) + '%', cls);

  currentSellingPrice = sellingPrice;
  calculateAmpleCare();
}

function calculateChecker() {
  const base = getBase(checkerBasis);
  const price = parseFloat(document.getElementById('checker-price').value);

  const setChk = (id, val, cls) => {
    const el = document.getElementById(id);
    el.textContent = val;
    el.className = 'margin-result-val' + (cls ? ' ' + cls : '');
  };

  if (!base) {
    setChk('chk-base', '—'); setChk('chk-margin-amt', '—'); setChk('chk-margin-pct', '—');
    document.getElementById('chk-base').textContent = '—';
    return;
  }

  document.getElementById('chk-base').textContent = fmt(base);

  if (isNaN(price)) {
    setChk('chk-margin-amt', '—'); setChk('chk-margin-pct', '—');
    return;
  }

  const diff = price - base;
  const diffPct = (diff / base) * 100;
  const cls = diff >= 0 ? 'positive' : 'negative';

  setChk('chk-margin-amt', (diff >= 0 ? '+' : '') + fmt(diff), cls);
  setChk('chk-margin-pct', (diffPct >= 0 ? '+' : '') + diffPct.toFixed(2) + '%', cls);
}

