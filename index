let ctoMode = false;

function isCtoMode() { return ctoMode; }

function onCtoToggle() {
  const cb = document.getElementById('cto-toggle');
  ctoMode = cb.checked;
  const label = document.getElementById('cto-toggle-label');
  if (label) label.classList.toggle('active', ctoMode);
  document.body.classList.toggle('cto-mode', ctoMode);

  if (ctoMode) {
    // Entering CTO mode: clear MRP-based SKU matching, clear SKU field lookup hints
    const skuDesc = document.getElementById('sku-desc');
    if (skuDesc) skuDesc.textContent = 'Custom product — SKU optional';
    const skuPills = document.getElementById('matching-skus');
    if (skuPills) skuPills.innerHTML = '<span style="font-family:var(--mono);font-size:11px;color:var(--text3)">—</span>';
    const mrpDescs = document.getElementById('mrp-descs');
    if (mrpDescs) mrpDescs.textContent = '—';
    // Force a recalc (will use manually-picked type if any)
    calculate();
  } else {
    // Leaving CTO mode: clear the CTO fields and restore normal behavior
    const sel = document.getElementById('cto-type-select');
    if (sel) sel.value = '';
    const desc = document.getElementById('cto-desc');
    if (desc) desc.value = '';
    updateLookups();
    calculate();
  }
}

function onCtoTypeChange() {
  if (!ctoMode) return;
  calculate();
}

function onCtoDescInput() {
  updateCalcAddToQuoteEnabled();
  // Refresh the Add to Quote bar summary so the "(description required)" hint updates
  if (typeof calculate === 'function') calculate();
}

function getCtoType() {
  if (!ctoMode) return null;
  const sel = document.getElementById('cto-type-select');
  return sel && sel.value ? sel.value : null;
}

function getCtoDesc() {
  if (!ctoMode) return '';
  const el = document.getElementById('cto-desc');
  return el ? el.value.trim() : '';
}

function updateCalcAddToQuoteEnabled() {
  // In CTO mode, Add to Quote requires a description
  const btn = document.querySelector('#calc-add-to-quote-bar button');
  if (!btn) return;
  if (ctoMode) {
    const desc = getCtoDesc();
    if (!desc) {
      btn.style.opacity = '0.5';
      btn.title = 'Enter a description to add a CTO product to the quote';
    } else {
      btn.style.opacity = '';
      btn.title = '';
    }
  } else {
    btn.style.opacity = '';
    btn.title = '';
  }
}

function detectType(skuVal, mrpVal) {
  if (typeof isCtoMode === 'function' && isCtoMode()) {
    return getCtoType();
  }
  if (skuVal) {
    const upper = skuVal.toUpperCase().trim();
    const match = DEVICES.find(d => d.sku.toUpperCase() === upper);
    if (match) return match.type;
  }
  if (mrpVal) {
    const match = DEVICES.find(d => d.mrp === parseInt(mrpVal));
    if (match) return match.type;
  }
  return null;
}

function setEl(id, val) { document.getElementById(id).textContent = val; }

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}

