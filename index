  /* "Based on your sell prices" badge in summary */
  body.light-mode #qs-deal-basis-badge { color: #636366 !important; }

  /* Italic working-out rows in BE recovery */
  body.light-mode .qt-sum-row[style*="italic"] span { color: #636366 !important; }

  /* Theme toggle */
  #theme-toggle {
    background: none;
    border: 1px solid var(--border2);
    color: var(--text3);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }
  #theme-toggle:hover { color: var(--text); border-color: var(--text3); }

  /* ── AppleCare mode pills ─────────────────────────────────────────── */
  .ac-mode-pills {
    display: flex;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
