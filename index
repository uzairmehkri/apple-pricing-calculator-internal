function switchTab(name, btn) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  if (btn) btn.classList.add('active');
  document.getElementById('tab-' + name).classList.add('active');
  window.scrollTo({ top: 0, behavior: 'instant' });
  if (name === 'search') {
    currentPage = 0;
    // Restore sub-filter bar UI to match current state
    const bar = document.getElementById('sub-filter-bar');
    const subRow = document.getElementById('sub-filters');
    if (currentFilter !== 'all' && SUB_FILTERS[currentFilter]) {
      subRow.innerHTML = SUB_FILTERS[currentFilter].map((s, i) =>
        `<button class="sub-btn${s.value === currentSubFilter ? ' active' : ''}" data-val="${s.value}" onclick="setSubFilter(this)">${s.label}</button>`
      ).join('');
      bar.style.display = 'block';
    }
    // Restore type filter button active state
    document.querySelectorAll('.filter-btn').forEach(b => {
      const btnType = b.textContent.trim();
      b.classList.toggle('active',
        (currentFilter === 'all' && btnType === 'All') ||
        (currentFilter === 'Mac' && btnType === 'Mac') ||
        (currentFilter === 'iPhone' && btnType === 'iPhone') ||
        (currentFilter === 'iPad' && btnType === 'iPad')
      );
    });
    doSearch();
  }
  if (name === 'quotation' && qtLines.length === 0) qtRender();
}

// ── PRICING CALCULATOR ───────────────────────────────
let lastEditedField = null;

// Customer Type rates — total combined discount %
// Mac: tp = 11.8%, extra CRT adds on top
// iPad: tp = 9%, extra CRT adds on top
// iPhone: no CRT options
// CRT% = extra discount on top of the device's standard fixed discount (tp)
// Mac base tp = 11.8%, iPad base tp = 9%, iPhone = no CRT options
// Total discount = tp + crt%; ITP = exGst * (1 - tp - crt%) - beAmt
const CUSTOMER_TYPE_RATES = {
  'non-crt':       { mac: 0,     ipad: 0,     iphone: 0    }, // no extra CRT
  'mac-govt':      { mac: 0.050, ipad: null,   iphone: null }, // 11.8+5.0=16.8%
  'mac-tier2':     { mac: 0.030, ipad: null,   iphone: null }, // 11.8+3.0=14.8%
  'mac-tier3':     { mac: 0.015, ipad: null,   iphone: null }, // 11.8+1.5=13.3%
  'mac-developer': { mac: 0.030, ipad: null,   iphone: null }, // 11.8+3.0=14.8%
  'mac-impetus':   { mac: 0.030, ipad: null,   iphone: null }, // 11.8+3.0=14.8%
  'ipad-govt':     { mac: null,  ipad: 0.020,  iphone: null }, // 9+2.0=11.0%
  'ipad-tier1':    { mac: null,  ipad: 0.020,  iphone: null }, // 9+2.0=11.0%
  'ipad-tier2':    { mac: null,  ipad: 0.020,  iphone: null }, // 9+2.0=11.0%
  'ipad-tier3':    { mac: null,  ipad: 0.015,  iphone: null }, // 9+1.5=10.5%
};

function getCustomerTypeRate(deviceType) {
  const sel = document.getElementById('inp-customer-type');
  if (!sel) return 0;
  const rates = CUSTOMER_TYPE_RATES[sel.value];
  if (!rates) return 0;
  const key = deviceType ? deviceType.toLowerCase() : null;
  if (key === 'mac') return rates.mac ?? 0;
  if (key === 'ipad') return rates.ipad ?? 0;
  if (key === 'iphone') return rates.iphone ?? 0;
  return 0;
}

function onCustomerTypeChange() {
  calculate();
}

// Build customer type options HTML based on device type context
function buildCustomerTypeOptions(deviceType, currentVal) {
  const MAC_OPTS = [
    ['non-crt',       'Non-CRT'],
    ['mac-govt',      'Govt & Tier 1 (16.8%)'],
    ['mac-tier2',     'CRT – Tier 2 (14.8%)'],
    ['mac-tier3',     'CRT – Tier 3 (13.3%)'],
    ['mac-developer', 'Developer (14.8%)'],
    ['mac-impetus',   'Impetus (14.8%)'],
  ];
  const IPAD_OPTS = [
    ['non-crt',      'Non-CRT'],
    ['ipad-govt',    'Govt (11.0%)'],
    ['ipad-tier1',   'CRT – Tier 1 (11.0%)'],
    ['ipad-tier2',   'CRT – Tier 2 (11.0%)'],
    ['ipad-tier3',   'CRT – Tier 3 (10.5%)'],
  ];
  const NO_CRT_ONLY = [['non-crt', 'Non-CRT (no CRT for iPhones)']];

  let opts;
  if (deviceType === 'Mac')    opts = MAC_OPTS;
  else if (deviceType === 'iPad') opts = IPAD_OPTS;
  else if (deviceType === 'iPhone') opts = NO_CRT_ONLY;
  else opts = [['non-crt','Non-CRT'], ...MAC_OPTS.slice(1).map(o => o), ...IPAD_OPTS.slice(1).map(o => o)];

  return opts.map(([val, label]) =>
    `<option value="${val}"${val === currentVal ? ' selected' : ''}>${label}</option>`
  ).join('');
}

function setDropdownByType(selId, deviceType) {
  const sel = document.getElementById(selId);
  if (!sel) return;
  const prev = sel.value;
  sel.innerHTML = buildCustomerTypeOptions(deviceType, prev);
  // If prev value no longer exists, reset to non-crt
  if (!sel.querySelector(`option[value="${prev}"]`)) sel.value = 'non-crt';
}

function updateCustomerTypeDropdown(deviceType) {
  setDropdownByType('inp-customer-type', deviceType);
  const sel = document.getElementById('inp-customer-type');
  const note = document.getElementById('customer-type-note');
  if (note && sel) {
    const v = sel.value;
    if (v === 'non-crt') { note.textContent = 'No CRT applied'; }
    else {
      const rates = CUSTOMER_TYPE_RATES[v];
      if (rates && deviceType) {
        const crtPct = deviceType === 'Mac' ? rates.mac : (deviceType === 'iPad' ? rates.ipad : 0);
        note.textContent = crtPct > 0 ? `CRT ${(crtPct * 100).toFixed(2)}% extra` : '';
      }
    }
  }
}

