function addCalcToQuote() {
  const ctoOn  = (typeof isCtoMode === 'function' && isCtoMode());
  const skuVal = document.getElementById('inp-sku').value.trim().toUpperCase();

  if (ctoOn) {
    // CTO path — no device lookup, use manually entered fields
    const ctoType = getCtoType();
    const ctoDesc = getCtoDesc();
    const mrpVal  = parseInt(document.getElementById('inp-mrp').value) || 0;
    if (!mrpVal)  { showToast('Enter an MRP first'); return; }
    if (!ctoType) { showToast('Pick a product type (Mac/iPhone/iPad)'); return; }
    if (!ctoDesc) { showToast('Description required for CTO products'); return; }

    const crt = getCrtRate() * 100;
    const marginPctInput = parseFloat(document.getElementById('margin-pct')?.value) || 0;
    const lineId = qtAddLine(skuVal || '', {
      crtRate: crt,
      marginPct: marginPctInput,
      skipRender: true,
      isCto: true,
      customMrp: mrpVal,
      customDesc: ctoDesc,
      customType: ctoType,
    });
    const acPlanVal = document.getElementById('ac-plan')?.value;
    const acMarginPctInput = parseFloat(document.getElementById('ac-margin-pct')?.value) || 0;
    if (acPlanVal && currentAcItp) {
      const line = qtLines.find(l => l.id === lineId);
      if (line) {
        line.acEnabled  = true;
        line.acPlan     = acPlanVal;
        line.acMarginPct = acMarginPctInput;
      }
    }
    qtRender();
    showToast('CTO product added to quote');
    // Switch to Quotation tab
    const qtTab = document.querySelector('.tab[onclick*="quotation"]');
    if (qtTab) switchTab('quotation', qtTab);
    return;
  }

  const device = DEVICES.find(d => d.sku.toUpperCase() === skuVal);
  if (!device) { showToast('Enter a valid SKU first'); return; }

  const crt = getCrtRate() * 100;
  const be  = getBeRate() * 100;

  // Read margin from margin builder if set
  const marginPctInput = parseFloat(document.getElementById('margin-pct')?.value) || 0;

  // Add the hardware line
  const lineId = qtAddLine(skuVal, { crtRate: crt, beRate: be, marginPct: marginPctInput, skipRender: true });

  // Check if AC plan is selected in the calculator
  const acPlanVal = document.getElementById('ac-plan')?.value;
  const acMarginPctInput = parseFloat(document.getElementById('ac-margin-pct')?.value) || 0;

  if (acPlanVal && currentAcItp) {
    const line = qtLines.find(l => l.id === lineId);
    if (line) {
      line.acEnabled  = true;
      line.acPlan     = acPlanVal;
      line.acMarginPct = acMarginPctInput;
    }
  }

  qtRender();

  // Switch to quotation tab
  const qtTab = document.querySelector('.tab[onclick*="quotation"]');
  if (qtTab) switchTab('quotation', qtTab);

  showToast('Added to Quote ✓');
}

function addToQuote(btn) {
  const d = DEVICES[parseInt(btn.getAttribute('data-idx'))];
  if (!d) return;

  // Add a new line to quotation with this SKU pre-filled
  qtAddLine(d.sku);
  showToast('Added to Quote → ' + d.sku);
}

function useDevice(btn) {
  const d = DEVICES[parseInt(btn.getAttribute('data-idx'))];
  if (!d) return;

  // Switch to calculator tab
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelector('.tab[onclick*="calculator"]').classList.add('active');
  document.getElementById('tab-calculator').classList.add('active');

  // Scroll to top first
  window.scrollTo({ top: 0, behavior: 'instant' });

  // Fill in SKU
  document.getElementById('inp-sku').value = d.sku;
  document.getElementById('inp-mrp').value = '';
  lastEditedField = 'sku';
  updateLookups();
  calculate();
  showToast('Loaded → ' + d.sku);
}

