// Copy arbitrary text to clipboard (for MRP and other plain values)
function copyText(txt, btn) {
  if (!txt) return;
  navigator.clipboard.writeText(String(txt)).then(function() {
    if (btn) {
      btn.classList.add('copied');
      var orig = btn.textContent;
      btn.textContent = '✓';
      setTimeout(function() { btn.classList.remove('copied'); btn.textContent = orig; }, 1500);
    }
  });
}

