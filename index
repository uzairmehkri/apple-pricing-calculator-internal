function updateLookups() {
  const mrpVal = parseInt(document.getElementById('inp-mrp').value) || null;
  const skuVal = document.getElementById('inp-sku').value.trim();

  // In CTO mode, type is user-picked, not SKU-derived — skip badge update
  if (typeof isCtoMode === 'function' && isCtoMode()) {
    // Still recalc but skip badge logic below
    const skuDescEl = document.getElementById('sku-desc');
    if (skuDescEl) skuDescEl.textContent = 'Custom product — SKU optional';
    return;
  }

  // Detect type
  const type = detectType(skuVal, mrpVal);
  updateTypeBadge(type);
  updateBeDefault(type);
  populateAcPlans();

  // Matching SKUs from MRP
  const skuPillsEl = document.getElementById('matching-skus');
  const mrpDescsEl = document.getElementById('mrp-descs');
  const skuDescEl  = document.getElementById('sku-desc');

  if (mrpVal) {
    const matches = DEVICES.filter(d => d.mrp === mrpVal);
    if (matches.length > 0) {
      skuPillsEl.innerHTML = matches.map(d =>
        `<span class="sku-pill" onclick="selectSku('${d.sku}')">${d.sku}</span>`
      ).join('');
      mrpDescsEl.innerHTML = matches.map(d =>
        `<div style="padding:2px 0;border-bottom:1px solid var(--border)">${d.type} — ${d.desc}</div>`
      ).join('');
    } else {
      skuPillsEl.innerHTML = '<span style="font-family:var(--mono);font-size:11px;color:var(--text3)">No match</span>';
      mrpDescsEl.textContent = 'No match';
    }
  } else {
    skuPillsEl.innerHTML = '<span style="font-family:var(--mono);font-size:11px;color:var(--text3)">—</span>';
    mrpDescsEl.textContent = '—';
  }

  if (skuVal) {
    const match = DEVICES.find(d => d.sku.toUpperCase() === skuVal.toUpperCase());
    skuDescEl.textContent = match ? match.desc : 'SKU not found';
  } else {
    skuDescEl.textContent = '—';
  }
}

function updateTypeBadge(type) {
  const el = document.getElementById('product-type-badge');
  el.className = 'type-badge';
  if (!type) { el.classList.add('none'); el.textContent = '—'; return; }
  const map = { 'Mac': ['mac','Mac (11.8%)'], 'iPhone': ['iphone','iPhone (7%)'], 'iPad': ['ipad','iPad (9%)'] };
  const [cls, label] = map[type] || ['none','—'];
  el.classList.add(cls);
  el.textContent = label;
}

function updateBeDefault(type) {
  const hintEl = document.getElementById('be-hint');
  const beSelect = document.getElementById('inp-be');
  if (!type) { hintEl.innerHTML = ''; return; }
  const defaultBe = (type === 'Mac') ? 0.02 : 0.015;
  const defaultLabel = (type === 'Mac') ? '2%' : '1.5%';
  hintEl.innerHTML = `Suggested: <span>${defaultLabel}</span>`;
  // Only auto-set if not on custom
  if (beSelect.value !== 'custom') {
    beSelect.value = defaultBe.toString();
    document.getElementById('inp-be-custom').style.display = 'none';
  }
}

function selectSku(sku) {
  document.getElementById('inp-sku').value = sku;
  document.getElementById('inp-mrp').value = '';
  lastEditedField = 'sku';
  updateLookups();
  calculate();
  showToast('SKU selected → ' + sku);
}

function calculate() {
  const mrpInput = parseInt(document.getElementById('inp-mrp').value) || null;
  const skuVal   = document.getElementById('inp-sku').value.trim().toUpperCase();
  const be       = getBeRate();
  const type     = detectType(skuVal, mrpInput);
  const ctoOn    = (typeof isCtoMode === 'function' && isCtoMode());

  let mrp = null;
  if (!ctoOn && skuVal) {
    const match = DEVICES.find(d => d.sku.toUpperCase() === skuVal);
    if (match) mrp = match.mrp;
  }
  if (!mrp && mrpInput) mrp = mrpInput;

  if (!mrp || !type) {
    const dash = '—';
    ['r-mrp','r-ex-gst','r-tp-pct','r-tp-amt','r-crt-pct','r-crt-amt',
     'r-be-pct','r-be-amt','r-itp','r-prog-itp','r-crt-total-pct','r-crt-total-amt']
      .forEach(id => { const el = document.getElementById(id); if (el) el.textContent = dash; });
    currentItp = null; currentProgItp = null; currentSellingPrice = null;
    const qtBar = document.getElementById('calc-add-to-quote-bar');
    if (qtBar) qtBar.style.display = 'none';
    updateCustomerTypeDropdown(null);
    // Hide customer type rows
    ['crt-itp-header','crt-total-pct-row','crt-total-amt-row'].forEach(id => {
      const el = document.getElementById(id); if (el) el.style.display = 'none';
    });
    calculateMarginBuilder(); calculateChecker();
    return;
  }

  const { tp, gst } = getProductInfo(type);
  const exGst  = mrp / gst;
  const tpAmt  = exGst * tp;
  const beAmt  = exGst * be;
  const itp    = exGst - tpAmt - beAmt;

  // Filter customer type dropdown to show only relevant options for this device
  updateCustomerTypeDropdown(type);

  setEl('r-mrp',    fmt(mrp));
  setEl('r-ex-gst', fmt(exGst));
  setEl('r-tp-pct', pct(tp));
  setEl('r-tp-amt', fmt(tpAmt));
  // Keep r-crt-pct/amt for display — show 0 since CRT now via customer type
  setEl('r-be-pct',  pct(be));
  setEl('r-be-amt',  fmt(beAmt));
  setEl('r-itp', fmt(itp));
  currentItp = itp;

  // CRT extra from customer type
  const crtExtra = getCustomerTypeRate(type);
  const hasCrt = crtExtra > 0;

  // Show/hide CRT section rows
  ['crt-itp-header','crt-total-pct-row','crt-total-amt-row'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = hasCrt ? (id === 'crt-itp-header' ? 'block' : 'flex') : 'none';
  });

  setEl('r-crt-pct', hasCrt ? pct(crtExtra) : '—');
  setEl('r-crt-amt', hasCrt ? fmt(exGst * crtExtra) : '—');

  // Left result box: always shows the "active" ITP (with CRT if set, else standard)
  // Right result box: always shows Non-CRT ITP as reference
  const mainLabel = document.getElementById('r-itp-main-label');
  if (hasCrt) {
    const crtAmt = exGst * crtExtra;
    const pItp = itp - crtAmt;
    if (mainLabel) mainLabel.textContent = 'Final ITP (incl. CRT)';
    setEl('r-prog-itp', fmt(pItp));
    currentProgItp = pItp;
    const el1 = document.getElementById('r-crt-total-pct');
    const el2 = document.getElementById('r-crt-total-amt');
    if (el1) el1.textContent = (crtExtra * 100).toFixed(2) + '%';
    if (el2) el2.textContent = fmt(crtAmt);
  } else {
    if (mainLabel) mainLabel.textContent = 'Final ITP';
    setEl('r-prog-itp', fmt(itp));
    currentProgItp = itp;
  }

  // Add to Quote bar
  const ctoOnForBar = (typeof isCtoMode === 'function' && isCtoMode());
  const qtBar = document.getElementById('calc-add-to-quote-bar');
  const qtSummary = document.getElementById('calc-quote-summary');
  if (ctoOnForBar && qtBar && qtSummary) {
    qtBar.style.display = 'flex';
    const ctoDescVal = (typeof getCtoDesc === 'function') ? getCtoDesc() : '';
    const tag = skuVal ? `${skuVal} · CTO` : 'CTO product';
    qtSummary.textContent = `${tag} · ITP ${fmt(itp)} · BE ${(be*100).toFixed(2)}%${ctoDescVal ? '' : ' · (description required)'}`;
  } else {
    const skuForQuote = DEVICES.find(d => d.sku.toUpperCase() === skuVal);
    if (skuForQuote && qtBar && qtSummary) {
      qtBar.style.display = 'flex';
      qtSummary.textContent = `${skuVal} · ITP ${fmt(itp)} · BE ${(be*100).toFixed(2)}%`;
    } else if (qtBar) {
      qtBar.style.display = 'none';
    }
  }

  calculateMarginBuilder();
  calculateChecker();
}

