          <button class="sort-btn${accFilter.sort==='desc'?' active':''}" onclick="setAccSort('desc',this)">Price ↓</button>
        </div>
        <div class="pagination" id="acc-pagination" style="display:none">
          <button class="page-btn" id="acc-page-prev" onclick="changeAccPage(-1)">&#8592;</button>
