function qtAppleCareItp(item, tier) {
  if (!item) return null;
  if (tier === 't1' && item.t1) return item.t1;
  if (tier === 't2' && item.t2) return item.t2;
  if (tier === 't3' && item.t3) return item.t3;
  return item.itp; // std fallback
}

// Match a device (by type + desc keywords) to AppleCare+ plans in the CATALOG
function qtGetAppleCarePlans(deviceType, sku) {
  if (!deviceType || !sku) return [];
  var device = DEVICES.find(function(d) { return d.sku.toUpperCase() === (sku || '').toUpperCase(); });
  if (!device) return [];
  var desc = device.desc.toLowerCase();

  // Extract device characteristics
  var sizeRe  = /(\d+(?:\.\d+)?)[‑\-]inch/;
  var sizeM   = desc.match(sizeRe);
  var devSize = sizeM ? sizeM[1] : null;   // e.g. "14"

  var chipRe  = /apple\s+(m\d+(?:\s+(?:pro|max|ultra))?)\s+chip/i;
  var chipM   = desc.match(chipRe);
  var devChip = chipM ? chipM[1].toLowerCase().trim() : null;  // e.g. "m5 pro"
  var genM    = devChip ? devChip.match(/m(\d+)/) : null;
  var devGen  = genM ? genM[1] : null;   // e.g. "5"

  var isMBP    = desc.includes('macbook pro');
  var isMBA    = desc.includes('macbook air');
  var isNeo    = desc.includes('macbook neo');
  var isiMac   = desc.includes('imac');
  var isMini   = desc.includes('mac mini');
  var isMPro   = desc.includes('mac pro') && !isMBP;
  var isStudio = desc.includes('mac studio');
  var isiPhone = desc.includes('iphone');
  var isiPadPro  = desc.includes('ipad pro');
  var isiPadAir  = desc.includes('ipad air');
  var isiPadMini = desc.includes('ipad mini');
  var isiPad     = desc.includes('ipad') && !isiPadPro && !isiPadAir && !isiPadMini;

  function score(plan) {
    var p = plan.desc.toLowerCase();
    var s = 0;

    // 1. Model name — REQUIRED gate (40 pts)
    var modelOk = false;
    if (isMBP    && p.includes('macbook pro') && !p.includes('mac pro '))  modelOk = true;
    if (isMBA    && p.includes('macbook air'))   modelOk = true;
    if (isNeo    && p.includes('macbook neo'))   modelOk = true;
    if (isiMac   && p.includes('imac'))          modelOk = true;
    if (isMini   && p.includes('mac mini'))      modelOk = true;
    if (isMPro   && p.includes('mac pro') && !p.includes('macbook')) modelOk = true;
    if (isStudio && p.includes('mac studio'))    modelOk = true;
    if (isiPhone && p.includes('iphone'))        modelOk = true;
    if (isiPadPro  && p.includes('ipad pro'))    modelOk = true;
    if (isiPadAir  && p.includes('ipad air'))    modelOk = true;
    if (isiPadMini && p.includes('ipad mini'))   modelOk = true;
    if (isiPad     && (p.includes('ipad (') || /ipad a\d{2}/.test(p))) modelOk = true;
    if (!modelOk) return 0;
    s += 40;

    // 2. Screen size (30 pts exact, -20 wrong size)
    if (devSize) {
      var escaped = devSize.replace('.', '\\.');
      var szRe = new RegExp(escaped + '[\\u2011\\-]inch|' + escaped + '[\\u2011\\-]in[\\s)]');
      if (szRe.test(p))            s += 30;
      else if (p.includes(devSize)) s += 5;   // weak hit (e.g. number appears elsewhere)
      else                          s -= 20;  // wrong size
    }

    // 3. Chip generation (25 pts exact, -15 wrong gen)
    if (devChip && devGen) {
      var baseChip = 'm' + devGen;
      var proChip  = 'm' + devGen + ' pro';
      var maxChip  = 'm' + devGen + ' max';

      if (devChip === baseChip) {
        // Base chip device — penalise Pro/Max plans
        if (p.includes('(' + baseChip + ')'))           s += 25;
        else if (p.includes(proChip) || p.includes(maxChip)) s -= 8;
        else if (p.includes(baseChip))                  s += 15;
      } else {
        // Pro/Max device — prefer Pro/Max plans
        if (p.includes(devChip))                        s += 25;  // exact e.g. "m5 pro"
        else if (p.includes(proChip) || p.includes(maxChip)) s += 18;
        else if (p.includes(baseChip))                  s += 8;
      }

      // Penalise clearly wrong generations
      for (var g = 1; g <= 5; g++) {
        var gStr = 'm' + g;
        if (g !== parseInt(devGen, 10) && p.includes(gStr) && !p.includes('m' + devGen)) s -= 15;
      }
    }

    // 4. iPhone model specifics
    if (isiPhone) {
      var phoneModels = ['17 pro max','17 pro','17 air','17e','17 plus','17 ',
                         '16 pro max','16 pro','16e','16 plus','16 ',
                         '15 pro max','15 pro','15 plus','15 ',
                         '14 pro max','14 pro','14 plus','14 ',
                         '13 pro max','13 pro','13 mini','13 ',
                         'air','se'];
      var devPhone = null, planPhone = null;
      for (var mi = 0; mi < phoneModels.length; mi++) {
        var m = phoneModels[mi].trim();
        if (!devPhone  && desc.includes('iphone ' + m))  devPhone  = m;
        if (!planPhone && p.includes('iphone ' + m))     planPhone = m;
      }
      if (devPhone && planPhone) {
        if (devPhone === planPhone) s += 20;
        else s -= 15;
      }
    }

    // 5. iPad size specifics
    if (isiPadPro || isiPadAir) {
      ['11-inch','13-inch','12.9-inch',
       '11\u2011inch','13\u2011inch'].forEach(function(sz) {
        if (desc.includes(sz) && p.includes(sz))         s += 10;
        else if (desc.includes(sz) && !p.includes(sz))   s -= 8;
      });
    }

    return s;
  }

  var familyMap = { Mac: 'Mac', iPhone: 'iPhone', iPad: 'iPad' };
  var family = familyMap[deviceType];
  if (!family) return [];

  var candidates = CATALOG.applecare.filter(function(p) {
    return p.family === family && p.section;
  });
  if (candidates.length === 0) return [];

  var scored = candidates
    .map(function(p) { return { plan: p, sc: score(p) }; })
    .filter(function(x) { return x.sc > 0; })
    .sort(function(a, b) { return b.sc - a.sc; });

  if (scored.length === 0) return [];

  var top = scored[0].sc;
  var threshold = Math.max(top * 0.72, 45); // tight: must be close to top score
  return scored
    .filter(function(x) { return x.sc >= threshold; })
    .map(function(x) { return x.plan; })
    .slice(0, 12);
}

// Set AC mode (amplecare | applecare) and re-render
function qtSetAcMode(id, mode) {
  const line = qtGetLineData(id);
  if (!line) return;
  line.acMode = mode;
  // Reset plan selection when switching modes
  line.acPlan = '';
  line.apcPlanIdx = null;
  line.acMarginPct = 0;
  line.acMarginAmt = null;
  line.acSellPrice = null;
  line.acCustomItp = null;
  line.acCustomPct = null;
  qtRender();
}

