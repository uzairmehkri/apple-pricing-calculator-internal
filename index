const fmt = n => '₹' + Math.round(n).toLocaleString('en-IN');
const pct = n => (n * 100).toFixed(2) + '%';


// ═══ GST CALCULATOR FUNCTIONS ═══
function gstCalcRemove() {
  const val = parseFloat(document.getElementById('gst-incl-input').value);
  const resEl = document.getElementById('gst-excl-result');
  const amtEl = document.getElementById('gst-remove-amt');
  if (!val || isNaN(val)) { resEl.textContent = '—'; amtEl.textContent = '—'; return; }
  const exGst = val / 1.18;
  const gstAmt = val - exGst;
  resEl.textContent = '₹' + exGst.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  amtEl.textContent = '₹' + gstAmt.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function gstCalcAdd() {
  const val = parseFloat(document.getElementById('gst-excl-input').value);
  const resEl = document.getElementById('gst-incl-result');
  const amtEl = document.getElementById('gst-add-amt');
  if (!val || isNaN(val)) { resEl.textContent = '—'; amtEl.textContent = '—'; return; }
  const inclGst = val * 1.18;
  const gstAmt = inclGst - val;
  resEl.textContent = '₹' + inclGst.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  amtEl.textContent = '₹' + gstAmt.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function getProductInfo(type) {
  if (!type) return { tp: 0, gst: 1.18 };
  if (type === 'Mac')    return { tp: 0.118, gst: 1.18 };
  if (type === 'iPhone') return { tp: 0.07,  gst: 1.18 };
  if (type === 'iPad')   return { tp: 0.09,  gst: 1.18 };
  return { tp: 0, gst: 1.18 };
}

