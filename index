// iPhone model matching — handle models that share prefix (e.g. "iPhone 17" vs "iPhone 17 Pro")
function matchesSubFilter(desc, sub) {
  if (!sub) return true;
  // Special markers for base iPhone 16/17 (not Pro/Plus/e)
  if (sub === 'iPhone 17 2') return /iPhone 17 \d/.test(desc) && !desc.includes('Pro') && !desc.includes('17e');
  if (sub === 'iPhone 16 2') return /iPhone 16 \d/.test(desc) && !desc.includes('Plus') && !desc.includes('16e');
  if (sub === 'iPhone 17 Pro ') return desc.includes('iPhone 17 Pro') && !desc.includes('Pro Max');
  return desc.includes(sub);
}

function changePage(dir) {
  const maxPage = Math.ceil(currentResults.length / PAGE_SIZE) - 1;
  currentPage = Math.max(0, Math.min(maxPage, currentPage + dir));
  renderPage();
}

function doSearch() {
  const q = document.getElementById('search-input').value.trim().toLowerCase();

  let results = DEVICES;
  if (currentFilter !== 'all') {
    results = results.filter(d => d.type === currentFilter);
  }
  if (currentSubFilter) {
    results = results.filter(d => matchesSubFilter(d.desc, currentSubFilter));
  }
  if (q.length > 0) {
    const terms = q.split(' ').filter(Boolean);
    results = results.filter(d => {
      const haystack = (d.type + ' ' + d.sku + ' ' + d.desc + ' ' + d.mrp).toLowerCase();
      return terms.every(t => haystack.includes(t));
    });
  }

  // Sort by price
  results = [...results].sort((a, b) =>
    currentSort === 'asc' ? a.mrp - b.mrp : b.mrp - a.mrp
  );

  currentResults = results;
  currentPage = 0;
  renderPage();
}

function renderPage() {
  const tableEl = document.getElementById('search-results');
  const countEl = document.getElementById('results-count-text');
  const paginationEl = document.getElementById('pagination');
  const indicatorEl = document.getElementById('page-indicator');
  const prevBtn = document.getElementById('page-prev');
  const nextBtn = document.getElementById('page-next');

  const total = currentResults.length;
  const totalPages = Math.ceil(total / PAGE_SIZE);
  const start = currentPage * PAGE_SIZE;
  const shown = currentResults.slice(start, start + PAGE_SIZE);

  // Update meta text
  if (total === 0) {
    countEl.textContent = '0 results';
  } else if (totalPages === 1) {
    countEl.textContent = `Showing ${total} result${total !== 1 ? 's' : ''}`;
  } else {
    countEl.textContent = `${start + 1}–${Math.min(start + PAGE_SIZE, total)} of ${total} results`;
  }

  // Show/hide pagination
  if (totalPages > 1) {
    paginationEl.style.display = 'flex';
    indicatorEl.textContent = `${currentPage + 1} / ${totalPages}`;
    prevBtn.disabled = currentPage === 0;
    nextBtn.disabled = currentPage >= totalPages - 1;
  } else {
    paginationEl.style.display = 'none';
  }

  if (shown.length === 0) {
    tableEl.innerHTML = total === 0
      ? '<div class="no-results">No results found. Try different keywords.</div>'
      : '<div class="no-results" style="color:var(--text3)">Start typing to search…</div>';
    return;
  }

  const rows = shown.map(d => {
    const idx = DEVICES.indexOf(d);
    return `
    <tr>
      <td class="td-type ${d.type.toLowerCase()}">${d.type}</td>
      <td class="td-sku">${d.sku}</td>
      <td class="td-desc">${d.desc}</td>
      <td class="td-mrp">${fmt(d.mrp)}</td>
      <td>
        <div style="display:flex;gap:4px">
          <button class="use-btn" data-idx="${idx}" onclick="useDevice(this)" title="Open in Calculator">Calc ↗</button>
          <button class="use-btn use-btn-quote" data-idx="${idx}" onclick="addToQuote(this)" title="Add to Quotation">+ Quote</button>
        </div>
      </td>
    </tr>
  `}).join('');

  const cards = shown.map(d => {
    const idx = DEVICES.indexOf(d);
    const typeClass = d.type.toLowerCase();
    return `
    <div class="device-card">
      <div class="card-top">
        <div class="card-meta">
          <span class="td-type ${typeClass}" style="font-family:var(--mono);font-size:10px">${d.type}</span>
          <span class="card-sku">${d.sku}</span>
        </div>
      </div>
      <div class="card-desc">${d.desc}</div>
      <div class="card-bottom">
        <div class="card-mrp">${fmt(d.mrp)}</div>
        <div style="display:flex;gap:6px">
          <button class="card-use-btn" data-idx="${idx}" onclick="useDevice(this)">Calc ↗</button>
          <button class="card-use-btn card-use-btn-quote" data-idx="${idx}" onclick="addToQuote(this)">+ Quote</button>
        </div>
      </div>
    </div>
  `}).join('');

  tableEl.innerHTML = `
    <table class="device-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>SKU</th>
          <th>Description</th>
          <th style="text-align:right">MRP</th>
          <th></th>
        </tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
    <div class="device-cards">${cards}</div>
  `;
}

function generateQuote() {
  const date = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' });
  const quoteNo = 'QT-' + Date.now().toString().slice(-6);

  // Build line data
  const rows = [];
  let itemNo = 1;
  let grandTotal = 0;
  let hasAc = false;

  qtLines.forEach(line => {
    const r = qtCalcLine(line);
    if (!r) return;

    let device;
    if (line.isAccessory) {
      device = {
        sku:  line.sku || '',
        desc: line.customDesc || '',
        mrp:  line.customMrp,
        type: line.customType || 'Accessory',
      };
    } else if (line.isCto) {
      device = {
        sku:  line.sku || '',
        desc: line.customDesc || '',
        mrp:  line.customMrp,
        type: line.customType,
      };
    } else {
      device = DEVICES.find(d => d.sku === line.sku);
      if (!device) return;
    }

    const useTarget = line.targetPrice && !isNaN(line.targetPrice) && line.usePriceMode === 'target';
    const unitPrice = useTarget ? line.targetPrice : r.sellEach;
    const totalPrice = unitPrice * line.qty;
