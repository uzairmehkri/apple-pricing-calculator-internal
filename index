// Map device type → plan category
// MacBook Neo SKUs start with MHFA, MHFC, MHFD, MHFE, MHFF, MHFG, MHFH, MHFJ
const MACBOOK_NEO_SKUS = new Set(
  DEVICES.filter(d => d.type === 'Mac' && d.desc.toLowerCase().includes('macbook neo')).map(d => d.sku)
);

function getAcCategory(deviceType, sku) {
  if (!deviceType) return null;
  if (deviceType === 'Mac') {
    if (sku && MACBOOK_NEO_SKUS.has(sku.toUpperCase())) return 'MacbookNeo';
    return 'Mac';
  }
  if (deviceType === 'iPhone' || deviceType === 'iPad') return 'MobileTablets';
  return null;
}

function populateAcPlans() {
  const skuVal = document.getElementById('inp-sku').value.trim().toUpperCase();
  const mrpVal = parseInt(document.getElementById('inp-mrp').value) || null;
  const type   = detectType(skuVal, mrpVal);
  const cat    = getAcCategory(type, skuVal);
  const select = document.getElementById('ac-plan');

  select.innerHTML = '<option value="">— Select a plan —</option>';
  document.getElementById('ac-offerings').textContent = '—';
  document.getElementById('ac-rate').textContent = '—';

  if (!cat) {
    select.innerHTML = '<option value="">— Enter SKU or MRP first —</option>';
    resetAcCalc();
    return;
  }

  AC_PLANS[cat].forEach((plan, i) => {
    const opt = document.createElement('option');
    opt.value = `${cat}:${i}`;
    opt.textContent = plan.label;
    select.appendChild(opt);
  });

  calculateAmpleCare();
}

function calculateAmpleCare() {
  const select   = document.getElementById('ac-plan');
  const val      = select.value;
  const sellingExGst = currentSellingPrice; // from margin builder

  if (!val) { resetAcCalc(); return; }

  const [cat, idx] = val.split(':');
  const plan = AC_PLANS[cat][parseInt(idx)];

  // Update info fields
  document.getElementById('ac-offerings').textContent = plan.offerings;
  document.getElementById('ac-rate').textContent =
    plan.type === 'pct' ? (plan.rate * 100).toFixed(2) + '%' : '₹' + plan.rate.toLocaleString('en-IN');

  if (!sellingExGst) { resetAcCalc(plan); return; }

  // Core calculation
  const sellingIncGst = sellingExGst * 1.18;
  const acItp = plan.type === 'pct'
    ? sellingIncGst * plan.rate
    : plan.rate; // fixed rate for MacBook Neo

  document.getElementById('ac-selling-ex').textContent  = fmt(sellingExGst);
  document.getElementById('ac-selling-inc').textContent = fmt(sellingIncGst);
  document.getElementById('ac-rate-display').textContent =
    plan.type === 'pct' ? (plan.rate * 100).toFixed(2) + '%' : '₹' + plan.rate.toLocaleString('en-IN') + ' (fixed)';
  document.getElementById('ac-itp').textContent = fmt(acItp);

  // Store for margin builder
  currentAcItp = acItp;
  calculateAcMargin();
}

function resetAcCalc(plan) {
  ['ac-selling-ex','ac-selling-inc','ac-rate-display','ac-itp',
   'ac-mb-margin-amt','ac-mb-margin-pct','ac-selling-price'].forEach(id => {
    document.getElementById(id).textContent = '—';
  });
  if (plan) {
    document.getElementById('ac-offerings').textContent = plan.offerings;
    document.getElementById('ac-rate').textContent =
      plan.type === 'pct' ? (plan.rate * 100).toFixed(2) + '%' : '₹' + plan.rate.toLocaleString('en-IN');
  }
  currentAcItp = null;
}

let currentAcItp = null;

function onAcMarginPctInput() {
  document.getElementById('ac-margin-amt').value = '';
  calculateAcMargin();
}

function onAcMarginAmtInput() {
  document.getElementById('ac-margin-pct').value = '';
  calculateAcMargin();
}

function calculateAcMargin() {
  // Bug fix: removed undefined 'sellInput' variable reference which threw a ReferenceError
  // and prevented the AmpleCare margin from ever computing.
  const base     = currentAcItp;
  const pctInput = parseFloat(document.getElementById('ac-margin-pct').value);
  const amtInput = parseFloat(document.getElementById('ac-margin-amt').value);

  const setAc = (id, val, cls) => {
    const el = document.getElementById(id);
    el.textContent = val;
    el.className = 'ac-row-val' + (id === 'ac-selling-price' ? ' ac-itp-val' : '') + (cls ? ' ' + cls : '');
  };

  if (!base) {
    ['ac-mb-margin-amt','ac-mb-margin-pct','ac-selling-price'].forEach(id => setAc(id, '—'));
    return;
  }

  let sellingPrice, marginAmt, marginPct;

  if (!isNaN(pctInput)) {
    marginAmt    = base * (pctInput / 100);
    sellingPrice = base + marginAmt;
    marginPct    = pctInput;
  } else if (!isNaN(amtInput)) {
    marginAmt    = amtInput;
    sellingPrice = base + amtInput;
    marginPct    = (amtInput / base) * 100;
  } else {
    ['ac-mb-margin-amt','ac-mb-margin-pct','ac-selling-price'].forEach(id => setAc(id, '—'));
    return;
  }

  const cls = marginAmt >= 0 ? 'ac-margin-positive' : 'ac-margin-negative';
  setAc('ac-mb-margin-amt', (marginAmt >= 0 ? '+' : '') + fmt(marginAmt), cls);
  setAc('ac-mb-margin-pct', (marginPct >= 0 ? '+' : '') + marginPct.toFixed(2) + '%', cls);
  setAc('ac-selling-price', fmt(sellingPrice));
}

  // Select-all on focus for all quotation number inputs — cursor goes to end
  document.addEventListener('focusin', e => {
    if (e.target.matches('.qt-input[type="number"], .qt-target-line-input')) {
      e.target.select();
    }
  });

