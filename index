          <div id="qr-ac-margin-pct-${line.id}" class="qt-be-margin-hint" style="display:none"></div>
        </div>
      </div>` : '<span style="font-family:var(--mono);font-size:10px;color:#555;margin-left:8px">Enter a valid device SKU first</span>') : ''}

      ${line.acEnabled && line.acMode === 'applecare' ? qtRenderAppleCareSection(line, type) : ''}
    </div>
  </div>`;
}

function qtUpdateField(id, field, value) {
  const line = qtGetLineData(id);
  if (!line) return;
  if (field === 'sku') {
    line.sku = value.toUpperCase().trim();
    // Auto-fill BE rate from device default if user hasn't set it yet
    // (skip for CTO lines — their BE is set when the line is created)
    if (line.beRate === null && !line.isCto && !line.isAccessory) {
      const dev = DEVICES.find(d => d.sku === line.sku);
      if (dev) line.beRate = dev.type === 'Mac' ? 2 : 1.5;
    }
  }
  else if (field === 'qty') line.qty = Math.max(1, parseInt(value) || 1);
  else if (field === 'sellPrice') {
    line.sellPrice = value === '' || value === null ? null : (parseFloat(value) || 0);
    if (line.sellPrice != null) {
      line.marginPct = 0; line.marginAmt = null;
      const pEl = document.getElementById(`qf-marginpct-${id}`);  if (pEl) pEl.value = '';
      const aEl = document.getElementById(`qf-marginamt-${id}`);  if (aEl) aEl.value = '';
    }
  }
  else if (field === 'marginPct') {
    line.marginPct = value === '' || value === null ? 0 : (parseFloat(value) || 0);
    line.marginAmt = null; line.sellPrice = null;
    const amtEl = document.getElementById(`qf-marginamt-${id}`);   if (amtEl) amtEl.value = '';
    const spEl  = document.getElementById(`qf-sellprice-${id}`);   if (spEl) spEl.value = '';
  }
  else if (field === 'marginAmt') {
    line.marginAmt = value === '' || value === null ? null : (parseFloat(value) || 0);
    if (line.marginAmt != null) {
      line.marginPct = 0; line.sellPrice = null;
      const pctEl = document.getElementById(`qf-marginpct-${id}`); if (pctEl) pctEl.value = '';
      const spEl  = document.getElementById(`qf-sellprice-${id}`); if (spEl) spEl.value = '';
    }
  }
  else if (field === 'acSellPrice') {
    line.acSellPrice = value === '' || value === null ? null : (parseFloat(value) || 0);
    if (line.acSellPrice != null) {
      line.acMarginPct = 0; line.acMarginAmt = null;
      const p = document.getElementById(`qf-acmarginpct-${id}`); if (p) p.value = '';
      const a = document.getElementById(`qf-acmarginamt-${id}`); if (a) a.value = '';
    }
  }
  else if (field === 'acMarginAmt') {
    line.acMarginAmt = value === '' || value === null ? null : (parseFloat(value) || 0);
    if (line.acMarginAmt != null) {
      line.acMarginPct = 0; line.acSellPrice = null;
      const p = document.getElementById(`qf-acmarginpct-${id}`); if (p) p.value = '';
      const s = document.getElementById(`qf-acsellprice-${id}`); if (s) s.value = '';
    }
  }
  else if (field === 'acCustomPct') {
    line.acCustomPct = value === '' || value === null ? null : (parseFloat(value) || 0);
    if (line.acCustomPct != null) { line.acCustomItp = null; const e = document.getElementById(`qf-accustomitp-${id}`); if (e) e.value = ''; }
  }
  else if (field === 'acCustomItp') {
    line.acCustomItp = value === '' || value === null ? null : (parseFloat(value) || 0);
    if (line.acCustomItp != null) { line.acCustomPct = null; const e = document.getElementById(`qf-accustompct-${id}`); if (e) e.value = ''; }
  }
  else if (field === 'crtRate')  line.crtRate  = value === '' || value === null ? 0 : (parseFloat(value) ?? 0);
  else if (field === 'beRate')   line.beRate   = (value === '' || value === null) ? null : parseFloat(value);
  else if (field === 'targetPrice') line.targetPrice = value ? parseFloat(value) : null;
  else if (field === 'usePriceMode') line.usePriceMode = value;
  else if (field === 'acMarginPct') {
    line.acMarginPct = parseFloat(value) || 0;
    line.acMarginAmt = null; line.acSellPrice = null;
    const ama = document.getElementById(`qf-acmarginamt-${id}`); if (ama) ama.value = '';
    const asp = document.getElementById(`qf-acsellprice-${id}`); if (asp) asp.value = '';
  }
  else if (field === 'acPlan') line.acPlan = value;
  else if (field === 'apcPlanIdx') { line.apcPlanIdx = value === '-1' ? null : parseInt(value); }
  else if (field === 'apcTier') { line.apcTier = value; }

  // For SKU changes: recalc immediately, re-render only when user leaves the field.
  // This prevents DOM rebuild from stealing focus while typing.
  if (field === 'sku') {
    qtRecalcAll();
    // Attach a one-time blur handler to trigger the full re-render
    // (needed for AC plan options to update based on the new SKU)
    clearTimeout(window._skuRenderTimer);
    const skuInput = document.querySelector(`#qt-line-${id} input[style*="text-transform:uppercase"]`);
    if (skuInput && !skuInput._blurWired) {
      skuInput._blurWired = true;
      skuInput.addEventListener('blur', function onBlur() {
        skuInput.removeEventListener('blur', onBlur);
        skuInput._blurWired = false;
        qtRender();
        // After render, try to keep the next line's focus natural
      }, { once: true });
    }
  } else {
    qtRecalcAll();
  }
}

function qtToggleAc(id, enabled) {
  const line = qtGetLineData(id);
  if (!line) return;
  line.acEnabled = enabled;
  if (!enabled) { line.acPlan = ''; line.acMarginPct = 0; }
  qtRender();
}

function qtCalcLine(line) {
  let _type, _mrp, _itpDirect = null;
  if (line.isAccessory) {
    // Accessory / AppleCare line: ITP is taken directly from catalog (no GST/BE/CRT math)
    _type = line.customType || 'Accessory';
    _mrp  = line.customMrp;
    _itpDirect = line.customItp;
    if (!_mrp || _itpDirect == null) return null;
  } else if (line.isCto) {
    _type = line.customType;
    _mrp  = line.customMrp;
    if (!_type || !_mrp) return null;
  } else {
    const _d = DEVICES.find(d => d.sku === line.sku);
    if (!_d) return null;
    _type = _d.type;
    _mrp  = _d.mrp;
  }
  // Shim: compat alias so existing references to `device.type` / `device.mrp` still work
  const device = { type: _type, mrp: _mrp };

  let itp, exGst;
  if (line.isAccessory) {
    // Skip GST/tp/CRT/BE math; ITP comes straight from the catalog
    itp   = _itpDirect;
    exGst = _mrp / 1.18; // for downstream metrics that reference exGst
  } else {
    const pi = getProductInfo(device.type);
    const tp = pi.tp, gst = pi.gst;
    exGst = device.mrp / gst;

    // CRT% = extra discount ON TOP of device's standard tp
    const crtExtra = qtGetCustomerTypeRate(device.type); // 0 for non-CRT

    const beVal = (line.beRate === null || isNaN(line.beRate)) ? 0 : line.beRate;
    const be    = Math.min(2, Math.max(0, beVal)) / 100;

    // ITP = exGst * (1 - tp - crtExtra) - beAmt
    itp   = exGst - exGst * tp - exGst * crtExtra - exGst * be;
  }

  const sellEach  = (line.sellPrice != null)
    ? line.sellPrice
    : (line.marginAmt != null && line.marginAmt !== 0)
      ? itp + line.marginAmt
      : itp * (1 + line.marginPct / 100);
  const totalItp  = itp * line.qty;
  const totalSell = sellEach * line.qty;
  const hwMargin  = totalSell - totalItp;
  const hwMarginPct = (hwMargin / totalItp) * 100;

  // AmpleCare / AppleCare+
  let acItpEach = 0, acSellEach = 0;
  if (line.acEnabled && line.acMode === 'applecare' && line.apcPlanIdx != null) {
    // AppleCare+ from catalog
    const apcPlans = qtGetAppleCarePlans(_type, line.sku || '');
    const apcItem = apcPlans[line.apcPlanIdx];
    if (apcItem) {
      const tier = line.apcTier || 'std';
      acItpEach = qtAppleCareItp(apcItem, tier) || 0;
      acSellEach = (line.acSellPrice != null) ? line.acSellPrice
        : (line.acMarginAmt != null && line.acMarginAmt !== 0) ? acItpEach + line.acMarginAmt
        : acItpEach * (1 + (line.acMarginPct || 0) / 100);
    }
  } else if (line.acEnabled && line.acPlan) {
    const [cat, idx] = line.acPlan.split(':');
    const plan = AC_PLANS[cat]?.[parseInt(idx)];
    if (plan) {
      const sellIncGst = sellEach * 1.18;
      // AC ITP: custom ITP > custom % > plan default
      if (line.acCustomItp != null) {
        acItpEach = line.acCustomItp;
      } else if (line.acCustomPct != null) {
        acItpEach = sellIncGst * (line.acCustomPct / 100);
      } else {
        acItpEach = plan.type === 'pct' ? sellIncGst * plan.rate : plan.rate;
      }
      // AC sell: direct price > margin amount > margin %
      acSellEach = (line.acSellPrice != null)
        ? line.acSellPrice
        : (line.acMarginAmt != null && line.acMarginAmt !== 0)
          ? acItpEach + line.acMarginAmt
          : acItpEach * (1 + line.acMarginPct / 100);
    }
  }

  return {
    itp, sellEach, totalItp, totalSell, hwMargin, hwMarginPct,
    acItpEach, acSellEach,
    totalAcItp: acItpEach * line.qty,
    totalAcSell: acSellEach * line.qty,
    qty: line.qty,
    targetEach: line.targetPrice || null,
    targetMarginEach: line.targetPrice ? (line.targetPrice - itp) : null,
    targetMarginPct:  line.targetPrice && itp > 0 ? ((line.targetPrice - itp) / itp * 100) : null,
  };
}

function qtRecalcAll() {
  // Uncheck breakeven when recalcing
  const beCb = document.getElementById('qt-be-checkbox');
  if (beCb) beCb.checked = false;
  document.getElementById('qt-be-result').style.display = 'none';

  let grandItp = 0, grandSell = 0, grandAcItp = 0, grandAcSell = 0;
  let acLineCount = 0;

  qtLines.forEach(line => {
    const r = qtCalcLine(line);

    const set = (id, val, cls) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = val;
      el.className = 'qt-res-val' + (cls ? ' ' + cls : '');
    };

    if (!r) {
      [`qr-itp-${line.id}`,`qr-sell-${line.id}`,`qr-margin-${line.id}`,
       `qr-total-itp-${line.id}`,`qr-total-sell-${line.id}`].forEach(id => set(id, '—'));
      const acEl = document.getElementById(`qr-ac-sell-${line.id}`);
      if (acEl) acEl.textContent = '—';
      return;
    }

    const marginCls = r.hwMarginPct >= 0 ? 'pos' : 'neg';
    set(`qr-itp-${line.id}`,       fmt(r.itp));
    set(`qr-sell-${line.id}`,      fmt(r.sellEach));
    set(`qr-margin-${line.id}`,    `${r.hwMarginPct >= 0 ? '+' : ''}${r.hwMarginPct.toFixed(2)}%`, marginCls);

    // Sync CRT field to customer type rate (read-only when CT is active)
    const crtFieldEl = document.getElementById(`qf-crt-${line.id}`);
    if (crtFieldEl) {
      let _lineType;
      if (line.isCto) { _lineType = line.customType; }
      else {
        const lineDev = DEVICES.find(d => d.sku === line.sku);
        _lineType = lineDev ? lineDev.type : null;
      }
      const ctCrt = _lineType ? qtGetCustomerTypeRate(_lineType) : 0;
      if (ctCrt > 0) {
        crtFieldEl.value = (ctCrt * 100).toFixed(2);
        crtFieldEl.readOnly = true;
        crtFieldEl.style.opacity = '0.5';
        crtFieldEl.style.cursor = 'not-allowed';
      } else {
        if (crtFieldEl.readOnly) crtFieldEl.value = line.crtRate || 0;
        crtFieldEl.readOnly = false;
        crtFieldEl.style.opacity = '';
        crtFieldEl.style.cursor = '';
      }
    }

    // Update target status badge (% vs ITP) — always, not just on target input change
    // Update comparison display
      const compEl = document.getElementById(`qt-tp-comparison-${line.id}`);
      if (compEl) {
        if (line.targetPrice && r.itp) {
          const diff = line.targetPrice - r.itp;
          const diffPct = r.itp > 0 ? (diff / r.itp * 100) : 0;
          const sign = diff >= 0 ? '+' : '';
          const color = diff >= 0 ? '#69db7c' : '#ff8585';
          compEl.innerHTML = `<span style="color:${color}">Target is ${sign}₹${Math.abs(Math.round(diff)).toLocaleString('en-IN')} (${sign}${diffPct.toFixed(1)}%) vs ITP</span>`;
        } else { compEl.innerHTML = ''; }
      }
      // Toggle use-target / use-my-price button states
      const pmSellBtn = document.getElementById(`qt-pm-sell-${line.id}`);
      const pmTgtBtn  = document.getElementById(`qt-pm-target-${line.id}`);
      if (pmSellBtn && pmTgtBtn && line.targetPrice) {
        const isTarget = line.usePriceMode === 'target';
        pmSellBtn.style.display = ''; pmTgtBtn.style.display = '';
        pmSellBtn.style.borderColor = !isTarget ? '#ffe066' : 'var(--border2)';
        pmSellBtn.style.color       = !isTarget ? '#ffe066' : 'var(--text3)';
        pmTgtBtn.style.borderColor  = isTarget  ? '#ffe066' : 'var(--border2)';
        pmTgtBtn.style.color        = isTarget  ? '#ffe066' : 'var(--text3)';
      } else if (pmSellBtn && pmTgtBtn) {
        pmSellBtn.style.display = 'none'; pmTgtBtn.style.display = 'none';
      }

    const statusEl = document.getElementById(`qt-tp-status-${line.id}`);
    if (statusEl && line.targetPrice && !isNaN(line.targetPrice) && r && r.itp > 0) {
      const diff = line.targetPrice - r.itp;
      const pct  = (diff / r.itp) * 100;
      statusEl.textContent = `${diff >= 0 ? '+' : ''}${pct.toFixed(2)}% vs ITP`;
      statusEl.style.color = diff >= 0 ? 'var(--ipad)' : 'var(--iphone)';
    } else if (statusEl && (!line.targetPrice || isNaN(line.targetPrice))) {
      statusEl.textContent = '';
    }

    // Update target status badge dynamically
    const targetOrEl = document.getElementById(`qt-target-or-${line.id}`);
    if (targetOrEl) targetOrEl.textContent = '(per unit, ex-GST)';

    // Target margin cell
    const hasTarget = r.targetEach && !isNaN(r.targetEach);
    const targetCell = document.getElementById(`qr-target-cell-${line.id}`);
    const targetTotalCell = document.getElementById(`qr-target-total-cell-${line.id}`);
    const toggleEl = document.getElementById(`qt-pm-toggle-${line.id}`);

    if (targetCell) targetCell.style.display = hasTarget ? 'block' : 'none';
    if (toggleEl) toggleEl.style.display = hasTarget ? 'flex' : 'none';

    if (hasTarget) {
      // Update active button state
      const sellBtn = document.getElementById(`qt-pm-sell-${line.id}`);
      const tgtBtn  = document.getElementById(`qt-pm-target-${line.id}`);
      if (sellBtn) sellBtn.classList.toggle('active', line.usePriceMode !== 'target');
      if (tgtBtn)  tgtBtn.classList.toggle('active', line.usePriceMode === 'target');

      const tmEl = document.getElementById(`qr-target-margin-${line.id}`);
      if (tmEl) {
        const tCls = r.targetMarginEach >= 0 ? 'pos' : 'neg';
        tmEl.textContent = `${r.targetMarginEach >= 0 ? '+' : ''}${fmt(r.targetMarginEach)} (${r.targetMarginPct >= 0 ? '+' : ''}${r.targetMarginPct.toFixed(2)}%)`;
        tmEl.className = `qt-res-val ${tCls}`;
      }

      // ×qty total
      if (targetTotalCell) {
        if (line.qty > 1) {
          targetTotalCell.style.display = 'block';
          const labelEl = document.getElementById(`qr-target-total-label-${line.id}`);
          if (labelEl) labelEl.textContent = `Margin at Target (×${line.qty})`;
          const totalTargetMargin = r.targetMarginEach * line.qty;
          const tmTotal = document.getElementById(`qr-target-margin-total-${line.id}`);
          if (tmTotal) {
            tmTotal.textContent = `${totalTargetMargin >= 0 ? '+' : ''}${fmt(totalTargetMargin)}`;
            tmTotal.className = `qt-res-val ${totalTargetMargin >= 0 ? 'pos' : 'neg'}`;
          }
        } else {
          targetTotalCell.style.display = 'none';
        }
      }
    } else {
      if (targetTotalCell) targetTotalCell.style.display = 'none';
      const tmEl = document.getElementById(`qr-target-margin-${line.id}`);
      if (tmEl) { tmEl.textContent = '—'; tmEl.className = 'qt-res-val'; }
    }

    set(`qr-total-itp-${line.id}`, fmt(r.totalItp));
    set(`qr-total-sell-${line.id}`,fmt(r.totalSell));

    // Update total labels with real qty
    const qty = parseInt(line.qty) || 1;
    const itpLbl = document.getElementById(`qr-total-itp-label-${line.id}`);
    const sellLbl = document.getElementById(`qr-total-sell-label-${line.id}`);
    if (itpLbl)  itpLbl.textContent  = `Total ITP (×${qty})`;
    if (sellLbl) sellLbl.textContent = `Total Revenue (×${qty})`;

    const acItpEl = document.getElementById(`qr-ac-itp-${line.id}`);
    if (acItpEl) acItpEl.textContent = r.acItpEach > 0 ? fmt(r.acItpEach) : '—';

    const acEl = document.getElementById(`qr-ac-sell-${line.id}`);
    if (acEl) acEl.textContent = r.acSellEach > 0 ? fmt(r.acSellEach) : '—';

    grandItp     += r.totalItp;
    grandSell    += r.totalSell;
    grandAcItp   += r.totalAcItp;
    grandAcSell  += r.totalAcSell;
    if (line.acEnabled && line.acPlan && r.acItpEach > 0) acLineCount += line.qty;
  });

  // Summary
  // Hardware summary — respect per-line usePriceMode (target vs sell)
  let grandHwSellForSummary = 0;
  qtLines.forEach(line => {
    const r = qtCalcLine(line);
    if (!r) return;
    const useTarget = line.targetPrice && !isNaN(line.targetPrice) && line.usePriceMode === 'target';
    grandHwSellForSummary += useTarget ? line.targetPrice * line.qty : r.totalSell;
  });

  const hwMargin    = grandHwSellForSummary - grandItp;
  const hwMarginPct = grandItp > 0 ? (hwMargin / grandItp) * 100 : 0;
  const acMargin    = grandAcSell - grandAcItp;
  const dealItp     = grandItp + grandAcItp;
  const dealSell    = grandHwSellForSummary + grandAcSell;
  const dealMargin  = dealSell - dealItp;
  const dealPct     = dealItp > 0 ? (dealMargin / dealItp) * 100 : 0;

  const setSumEl = (id, val, cls) => {
    const el = document.getElementById(id); if (!el) return;
    el.textContent = val; el.className = cls || 'qt-neutral';
  };

  // Hardware section
  setSumEl('qs-total-itp',     fmt(grandItp));
  setSumEl('qs-total-sell',    fmt(grandHwSellForSummary));
  setSumEl('qs-hw-margin',     `${hwMargin >= 0 ? '+' : ''}${fmt(hwMargin)}`, hwMargin >= 0 ? 'qt-pos' : 'qt-neg');
  setSumEl('qs-hw-margin-pct', `${hwMarginPct >= 0 ? '+' : ''}${hwMarginPct.toFixed(2)}%`, hwMarginPct >= 0 ? 'qt-pos' : 'qt-neg');
  setSumEl('qs-total-ac-itp',  grandAcItp > 0 ? fmt(grandAcItp) : '—');

  // Show the plan rate being used (from first active AC line)
  const acRateRow = document.getElementById('qs-ac-rate-row');
  const acRateEl  = document.getElementById('qs-ac-rate');
  if (grandAcItp > 0 && acRateRow && acRateEl) {
    const acLine = qtLines.find(l => l.acEnabled && l.acPlan);
    if (acLine) {
      const [cat, idx] = acLine.acPlan.split(':');
      const plan = AC_PLANS[cat]?.[parseInt(idx)];
      if (plan) {
        acRateEl.textContent = plan.type === 'pct'
          ? `${(plan.rate * 100).toFixed(2)}% of sell price (inc. GST)`
          : `₹${plan.rate.toLocaleString('en-IN')} fixed`;
        acRateRow.style.display = 'flex';
      }
    }
  } else if (acRateRow) {
    acRateRow.style.display = 'none';
  }

  setSumEl('qs-total-ac-sell', grandAcSell > 0 ? fmt(grandAcSell) : '—');
  setSumEl('qs-ac-margin',     grandAcItp > 0 ? `${acMargin >= 0 ? '+' : ''}${fmt(acMargin)}` : '—', acMargin >= 0 ? 'qt-pos' : 'qt-neg');
  const acMarginPct = grandAcItp > 0 ? (acMargin / grandAcItp) * 100 : 0;
  setSumEl('qs-ac-margin-pct', grandAcItp > 0 ? `${acMarginPct >= 0 ? '+' : ''}${acMarginPct.toFixed(2)}%` : '—', acMarginPct >= 0 ? 'qt-pos' : 'qt-neg');

  // ── OVERALL DEAL — per-line target aware ──
  // Use each line's price based on usePriceMode (target or sell)
  let grandHwRevenue = 0;
  let hasAnyTarget = false;
  qtLines.forEach(line => {
    const r = qtCalcLine(line);
    if (!r) return;
    const useTarget = line.targetPrice && !isNaN(line.targetPrice) && line.usePriceMode === 'target';
    if (useTarget) {
      grandHwRevenue += line.targetPrice * line.qty;
      hasAnyTarget = true;
    } else {
      grandHwRevenue += r.totalSell;
    }
  });

  const hwLoss = grandHwRevenue - grandItp;

  const displayDealItp  = grandItp + grandAcItp;
  const displayDealSell = grandHwRevenue + grandAcSell;
  const displayMargin   = displayDealSell - displayDealItp;
  const displayPct      = displayDealItp > 0 ? (displayMargin / displayDealItp) * 100 : 0;
  const displayHwMargin = grandHwRevenue - grandItp;
  const displayAcMargin = grandAcSell - grandAcItp;

  const badge = document.getElementById('qs-deal-basis-badge');
  if (badge) badge.textContent = hasAnyTarget ? 'Includes customer targets' : 'Based on your sell prices';

  const hwRevLabel = document.getElementById('qs-hw-rev-label');
  if (hwRevLabel) hwRevLabel.textContent = hasAnyTarget ? 'HW Revenue (targets where entered)' : 'HW Revenue';

  setSumEl('qs-grand-hw-itp', fmt(grandItp));
  setSumEl('qs-grand-ac-itp', grandAcItp > 0 ? fmt(grandAcItp) : '—');
  document.getElementById('qs-grand-itp').textContent = fmt(displayDealItp);
  setSumEl('qs-grand-hw-sell', fmt(grandHwRevenue));
  if (hasAnyTarget) document.getElementById('qs-grand-hw-sell').style.color = '#e8c84a';
  else document.getElementById('qs-grand-hw-sell').style.color = '#ddd';
  setSumEl('qs-grand-ac-sell', grandAcSell > 0 ? fmt(grandAcSell) : '—');
  document.getElementById('qs-grand-sell').textContent = fmt(displayDealSell);
  setSumEl('qs-deal-hw-margin', `${displayHwMargin >= 0 ? '+' : ''}${fmt(displayHwMargin)}`, displayHwMargin >= 0 ? 'qt-pos' : 'qt-neg');
  setSumEl('qs-deal-ac-margin', grandAcItp > 0 ? `${displayAcMargin >= 0 ? '+' : ''}${fmt(displayAcMargin)}` : '—', displayAcMargin >= 0 ? 'qt-pos' : 'qt-neg');
  setSumEl('qs-deal-margin',     `${displayMargin >= 0 ? '+' : ''}${fmt(displayMargin)}`, displayMargin >= 0 ? 'qt-pos' : 'qt-neg');
  setSumEl('qs-deal-margin-pct', `${displayPct >= 0 ? '+' : ''}${displayPct.toFixed(2)}%`, displayPct >= 0 ? 'qt-pos' : 'qt-neg');

  // ── BE RECOVERY ──
  // The distributor always pays the full backend (Mac=2%, iPhone/iPad=1.5%).
  // If sales works from ITP with BE already deducted (e.g. 2%), they've already priced in the floor — effective margin = selling margin only.
  // If sales works from ITP with a lower BE (e.g. 0%), the difference (2%-0%=2%) comes back as a bonus — effective margin = selling margin + 2%.
  // Recovery = (fullBERate - enteredBERate) × exGST × qty
  const FULL_BE_RATE = { 'Mac': 0.02, 'iPhone': 0.015, 'iPad': 0.015 };
  let grandBeRecovery = 0;
  let grandItpAtFullBe = 0;
  let grandItpAt0Be = 0;
  let grandExGst = 0;
  let beRecoveryWorkings = [];
  qtLines.forEach(line => {
    let _type, _mrp;
    if (line.isCto) {
      _type = line.customType;
      _mrp  = line.customMrp;
      if (!_type || !_mrp) return;
    } else {
      const _d = DEVICES.find(d => d.sku === line.sku);
      if (!_d) return;
      _type = _d.type;
      _mrp  = _d.mrp;
    }
    const device = { type: _type, mrp: _mrp };
    const { tp, gst } = getProductInfo(device.type);
    const exGst = device.mrp / gst;
    const fullBe = FULL_BE_RATE[device.type] || 0.02;
    const rawBe = (line.beRate === null || isNaN(line.beRate)) ? 0 : line.beRate;
    const enteredBe = Math.min(fullBe * 100, Math.max(0, rawBe)) / 100;
    const recoveryRate = Math.max(0, fullBe - enteredBe);
    const lineRecovery = exGst * recoveryRate * line.qty;
    grandBeRecovery  += lineRecovery;
    grandExGst       += exGst * line.qty;
    const crtExtra = qtGetCustomerTypeRate(device.type);
    grandItpAtFullBe += (exGst - exGst * tp - exGst * crtExtra - exGst * fullBe) * line.qty;
    grandItpAt0Be    += (exGst - exGst * tp - exGst * crtExtra) * line.qty;
    if (recoveryRate > 0) {
      const pct = s => (s * 100).toFixed(1) + '%';
      beRecoveryWorkings.push(
        `(${pct(fullBe)} − ${pct(enteredBe)}) × ₹${Math.round(exGst).toLocaleString('en-IN')}${line.qty > 1 ? ` × ${line.qty}` : ''} = +₹${Math.round(lineRecovery).toLocaleString('en-IN')}`
      );
    }
  });

  const beSection = document.getElementById('qs-be-recovery-section');
  if (grandBeRecovery > 0) {
    const effectiveMargin    = displayMargin + grandBeRecovery;
    // Denominator = grandItp only (HW ITP as entered) — BE% is expressed as % of exGST/ITP, not deal total
    const effectiveBase      = grandItpAt0Be;
    const effectiveMarginPct = effectiveBase > 0 ? (effectiveMargin / effectiveBase) * 100 : 0;
    if (beSection) beSection.style.display = 'block';
    setSumEl('qs-be-recovery',          `+${fmt(grandBeRecovery)}`, 'qt-pos');
    setSumEl('qs-be-recovery-working',  beRecoveryWorkings.join(' + '));
    setSumEl('qs-effective-margin',     `${effectiveMargin >= 0 ? '+' : ''}${fmt(effectiveMargin)}`, effectiveMargin >= 0 ? 'qt-pos' : 'qt-neg');
    setSumEl('qs-effective-margin-working', `Deal Margin (${fmt(displayMargin)}) + BE Recovery (${fmt(grandBeRecovery)}) = ${fmt(effectiveMargin)}`);
    setSumEl('qs-effective-base',       `${fmt(effectiveBase)} (HW ITP at 0% BE)`);
    setSumEl('qs-effective-margin-pct', `${effectiveMarginPct >= 0 ? '+' : ''}${effectiveMarginPct.toFixed(2)}%`, effectiveMarginPct >= 0 ? 'qt-pos' : 'qt-neg');
  } else {
    if (beSection) beSection.style.display = 'none';
  }

  // Hide per-unit line (no longer needed as a separate summary element)
  const puLine = document.getElementById('qs-per-unit-line');
  if (puLine) puLine.style.display = 'none';

  // ── BREAKEVEN ──
  const beBar = document.getElementById('qt-be-bar');
  if (hwLoss < 0 && acLineCount > 0) {
    beBar.style.display = 'flex';
    document.getElementById('qt-be-shortfall').textContent = fmt(Math.abs(hwLoss));
    document.getElementById('qt-be-ac-count').textContent = acLineCount;
    beBar.dataset.hwLoss      = hwLoss;
    beBar.dataset.acLineCount = acLineCount;
    beBar.dataset.grandAcItp  = grandAcItp;
  } else {
    beBar.style.display = 'none';
    document.getElementById('qt-be-result').style.display = 'none';
    if (beCb) beCb.checked = false;
  }
}

function qtApplyBreakeven() {
  const beCb = document.getElementById('qt-be-checkbox');
  const beResult = document.getElementById('qt-be-result');
  const beBar = document.getElementById('qt-be-bar');
  const setSumElBe = (id, val, cls) => { const el = document.getElementById(id); if (el) { el.textContent = val; if (cls) el.className = cls; } };

  if (!beCb.checked) {
    beResult.style.display = 'none';
    qtRecalcAll();
    return;
  }

  const hwLoss      = parseFloat(beBar.dataset.hwLoss);
  const grandAcItp  = parseFloat(beBar.dataset.grandAcItp);
  const acLineCount = parseInt(beBar.dataset.acLineCount);

  // neededAcSell = AC ITP + |hwLoss|  →  AC covers own cost AND makes up hardware loss
  const neededTotalAcSell = grandAcItp + Math.abs(hwLoss);
  const neededPerUnit     = neededTotalAcSell / acLineCount;

  qtLines.forEach(line => {
    if (!line.acEnabled || !line.acPlan) return;
    const r = qtCalcLine(line);
    if (!r || r.acItpEach <= 0) return;

    const reqMarginPct = ((neededPerUnit - r.acItpEach) / r.acItpEach) * 100;

    const acEl = document.getElementById(`qr-ac-sell-${line.id}`);
    if (acEl) { acEl.textContent = fmt(neededPerUnit); acEl.className = 'qt-res-val gold'; }

    const acMargEl = document.getElementById(`qr-ac-margin-pct-${line.id}`);
    if (acMargEl) {
      acMargEl.textContent = `→ Need ${reqMarginPct >= 0 ? '+' : ''}${reqMarginPct.toFixed(2)}% AC margin to break even`;
      acMargEl.style.display = 'block';
    }
  });

  const grandAcSellNew = neededPerUnit * acLineCount;
  let grandItpBe = 0, grandSellBe = 0;
  qtLines.forEach(line => {
    const r = qtCalcLine(line);
    if (r) { grandItpBe += r.totalItp; grandSellBe += r.totalSell; }
  });

  const hasTargetB = qtLines.some(l => l.targetPrice && !isNaN(l.targetPrice) && l.usePriceMode === 'target');
  let grandHwRevB = 0;
  qtLines.forEach(line => {
    const r = qtCalcLine(line);
    if (!r) return;
    const useTarget = line.targetPrice && !isNaN(line.targetPrice) && line.usePriceMode === 'target';
    grandHwRevB += useTarget ? line.targetPrice * line.qty : r.totalSell;
  });

  const dealSellNew = grandHwRevB + grandAcSellNew;
  const dealItpNew  = grandItpBe + grandAcItp;
  const newMargin   = dealSellNew - dealItpNew;
  const newPct      = dealItpNew > 0 ? (newMargin / dealItpNew) * 100 : 0;

  document.getElementById('qs-total-ac-sell').textContent   = fmt(grandAcSellNew);

  // Update AC margin and AC margin % based on breakeven selling price
  const acMarginNew    = grandAcSellNew - grandAcItp;
  const acMarginPctNew = grandAcItp > 0 ? (acMarginNew / grandAcItp) * 100 : 0;
  const acMargEl  = document.getElementById('qs-ac-margin');
  const acMargPct = document.getElementById('qs-ac-margin-pct');
  if (acMargEl)  { acMargEl.textContent  = `${acMarginNew >= 0 ? '+' : ''}${fmt(acMarginNew)}`; acMargEl.className  = acMarginNew >= 0 ? 'qt-pos' : 'qt-neg'; }
  if (acMargPct) { acMargPct.textContent = `${acMarginPctNew >= 0 ? '+' : ''}${acMarginPctNew.toFixed(2)}%`; acMargPct.className = acMarginPctNew >= 0 ? 'qt-pos' : 'qt-neg'; }

  // Also update the Overall Deal AC margin column
  const dealAcMargEl = document.getElementById('qs-deal-ac-margin');
  if (dealAcMargEl) { dealAcMargEl.textContent = `${acMarginNew >= 0 ? '+' : ''}${fmt(acMarginNew)}`; dealAcMargEl.className = acMarginNew >= 0 ? 'qt-pos' : 'qt-neg'; }

  document.getElementById('qs-grand-sell').textContent      = fmt(dealSellNew);

  // Recalc effective margin with breakeven prices
  const beRecovEl = document.getElementById('qs-be-recovery');
  if (beRecovEl && beRecovEl.textContent !== '—') {
    const beRecovAmt = parseFloat(beRecovEl.textContent.replace(/[^0-9.]/g, '')) || 0;
    const effRevNew  = dealSellNew + beRecovAmt;
    const itpExclBe  = dealItpNew + beRecovAmt;
    const effMgn     = effRevNew - itpExclBe;
    const effMgnPct  = itpExclBe > 0 ? (effMgn / itpExclBe) * 100 : 0;
    setSumElBe('qs-effective-revenue',    fmt(effRevNew));
    setSumElBe('qs-effective-margin',     `${effMgn >= 0 ? '+' : ''}${fmt(effMgn)}`, effMgn >= 0 ? 'qt-pos' : 'qt-neg');
    setSumElBe('qs-effective-margin-pct', `${effMgnPct >= 0 ? '+' : ''}${effMgnPct.toFixed(2)}%`, effMgnPct >= 0 ? 'qt-pos' : 'qt-neg');
  }
  document.getElementById('qs-deal-margin').textContent     = `${newMargin >= 0 ? '+' : ''}${fmt(newMargin)}`;
  document.getElementById('qs-deal-margin-pct').textContent = `${newPct >= 0 ? '+' : ''}${newPct.toFixed(2)}%`;
  document.getElementById('qs-deal-margin').className       = newMargin >= 0 ? 'qt-pos' : 'qt-neg';
  document.getElementById('qs-deal-margin-pct').className   = newMargin >= 0 ? 'qt-pos' : 'qt-neg';

  document.getElementById('qt-be-per-ac').textContent = fmt(neededPerUnit);
  beResult.style.display = 'block';
}

