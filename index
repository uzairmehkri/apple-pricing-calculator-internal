function resetQuotation() {
  if (qtLines.length > 0 && !confirm('Clear all devices from the quote?')) return;
  qtLines = [];
  qtNextId = 1;
  const sel = document.getElementById('qt-customer-type');
  if (sel) { sel.innerHTML = '<option value="non-crt">Non-CRT</option>'; sel.value = 'non-crt'; }
