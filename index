function onAccSearch(v) { accFilter.search = v; accFilter.page = 0; renderAccPage(); }
function setAccFamilyFilter(f, btn) { accFilter.family = f; accFilter.page = 0; renderAccessoriesTab(); }
function setAccSort(s, btn) { accFilter.sort = s; renderAccPage(); document.querySelectorAll('#tab-accessories .sort-btn').forEach(b=>b.classList.remove('active')); if(btn) btn.classList.add('active'); }
function resetAccSearch() { accFilter = { family: 'all', search: '', sort: 'asc', page: 0 }; renderAccessoriesTab(); }
function changeAccPage(d) { accFilter.page += d; renderAccPage(); }

function renderAccPage() {
  let items = CATALOG.accessories.filter(a => {
    if (accFilter.family !== 'all' && a.family !== accFilter.family) return false;
    if (accFilter.search) {
      const s = accFilter.search.toLowerCase();
      const hay = (a.sku + ' ' + a.desc + ' ' + a.family + ' ' + a.mrp).toLowerCase();
      if (!s.split(' ').filter(Boolean).every(t => hay.includes(t))) return false;
    }
    return true;
  });
  items = [...items].sort((a, b) => accFilter.sort==='asc' ? a.mrp - b.mrp : b.mrp - a.mrp);

  const total = items.length;
  const totalPages = Math.max(1, Math.ceil(total / ACC_PAGE_SIZE));
  if (accFilter.page >= totalPages) accFilter.page = 0;
  const start = accFilter.page * ACC_PAGE_SIZE;
  const shown = items.slice(start, start + ACC_PAGE_SIZE);

  const countEl = document.getElementById('acc-results-count-text');
  const tableEl = document.getElementById('acc-search-results');
  const paginationEl = document.getElementById('acc-pagination');
  if (!countEl || !tableEl) return;

  if (total === 0) countEl.textContent = '0 results';
  else if (totalPages === 1) countEl.textContent = `Showing ${total} accessor${total!==1?'ies':'y'}`;
  else countEl.textContent = `${start+1}–${Math.min(start+ACC_PAGE_SIZE,total)} of ${total} accessories`;

  if (totalPages > 1) {
    paginationEl.style.display = 'flex';
    document.getElementById('acc-page-indicator').textContent = `${accFilter.page+1} / ${totalPages}`;
    document.getElementById('acc-page-prev').disabled = accFilter.page === 0;
    document.getElementById('acc-page-next').disabled = accFilter.page >= totalPages - 1;
  } else if (paginationEl) paginationEl.style.display = 'none';

  if (shown.length === 0) {
    tableEl.innerHTML = '<div class="no-results">No accessories match. Try different keywords or clear filters.</div>';
    return;
  }

  const rows = shown.map(a => {
    const idx = CATALOG.accessories.indexOf(a);
    const fam = (a.family||'Other').toLowerCase().replace(/\s+/g,'');
    return `
    <tr>
      <td class="td-type ${fam}">${a.family || 'Other'}</td>
      <td class="td-sku">${a.sku}</td>
      <td class="td-desc">${a.desc}</td>
      <td class="td-mrp">${_fmtR(a.mrp)}</td>
      <td class="td-mrp" style="color:#ffe066">${_fmtR(a.itp)}</td>
      <td>
        <div style="display:flex;gap:4px">
          <button class="use-btn" data-idx="${idx}" onclick="useAccessory(this)" title="Open in Calculator">Calc ↗</button>
          <button class="use-btn use-btn-quote" data-idx="${idx}" onclick="addAccessoryToQuote(this)" title="Add to Quotation">+ Quote</button>
        </div>
      </td>
    </tr>`;
  }).join('');

  const cards = shown.map(a => {
    const idx = CATALOG.accessories.indexOf(a);
    const fam = (a.family||'Other').toLowerCase().replace(/\s+/g,'');
    return `
    <div class="device-card">
      <div class="card-top">
        <div class="card-meta">
          <span class="td-type ${fam}" style="font-family:var(--mono);font-size:10px">${a.family || 'Other'}</span>
          <span class="card-sku">${a.sku}</span>
        </div>
      </div>
      <div class="card-desc">${a.desc}</div>
      <div class="card-bottom">
        <div class="card-mrp"><span style="color:#888;font-size:10px">MRP</span> ${_fmtR(a.mrp)} <span style="color:#888;font-size:10px;margin-left:8px">ITP</span> <span style="color:#ffe066">${_fmtR(a.itp)}</span></div>
        <div style="display:flex;gap:6px">
          <button class="card-use-btn" data-idx="${idx}" onclick="useAccessory(this)">Calc ↗</button>
          <button class="card-use-btn card-use-btn-quote" data-idx="${idx}" onclick="addAccessoryToQuote(this)">+ Quote</button>
        </div>
      </div>
    </div>`;
  }).join('');

  tableEl.innerHTML = `
    <table class="device-table">
      <thead>
        <tr>
          <th>Family</th>
          <th>SKU</th>
          <th>Description</th>
          <th style="text-align:right">MRP</th>
          <th style="text-align:right">ITP</th>
          <th></th>
        </tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
    <div class="device-cards">${cards}</div>
  `;
