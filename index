function qtAddLine(prefillSku, opts) {
  const id = qtNextId++;
  const o = opts || {};
  const prefillDev = prefillSku ? DEVICES.find(d => d.sku === prefillSku.toUpperCase()) : null;
  const defaultBeRate = prefillDev ? (prefillDev.type === 'Mac' ? 2 : 1.5) : (o.customType === 'Mac' ? 2 : o.customType ? 1.5 : null);
  qtLines.push({
    id,
    sku:         prefillSku || '',
    qty:         o.qty         ?? 1,
    marginPct:   o.marginPct   ?? 0,
    marginAmt:   o.marginAmt   ?? null,
    sellPrice:   o.sellPrice   ?? null,
    crtRate:     o.crtRate     ?? 0,
    beRate:      o.beRate      ?? defaultBeRate,
    targetPrice: null,
    usePriceMode: 'sell',
    acEnabled:   false,
    acMode:      o.acMode     ?? 'amplecare', // 'amplecare' | 'applecare'
    acPlan:      '',
    acMarginPct: 0,
    acMarginAmt: null,
    acSellPrice: null,
    acCustomPct: null,
    acCustomItp: null,
    isCto:       o.isCto       ?? false,
    customMrp:   o.customMrp   ?? null,
    customDesc:  o.customDesc  ?? '',
    customType:  o.customType  ?? null,
    isAccessory: o.isAccessory ?? false,
    customItp:   o.customItp   ?? null
  });
  if (!o.skipRender) {
    qtRender();
    setTimeout(() => {
      const el = document.getElementById(`qt-line-${id}`);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 50);
  }
  return id;
}

function qtRemoveLine(id) {
  qtLines = qtLines.filter(l => l.id !== id);
  qtRender();
}

function qtGetLineData(id) {
  return qtLines.find(l => l.id === id);
}

function qtRender() {
  // Show/hide export button
  const exportBtn = document.getElementById('qt-export-btn');
  if (exportBtn) exportBtn.style.display = qtLines.length > 0 ? 'inline-block' : 'none';

  const container = document.getElementById('qt-lines');
  if (qtLines.length === 0) {
    container.innerHTML = '<div class="qt-empty">No devices added yet. Click "+ Add Device" to start building a quote.</div>';
    document.getElementById('qt-summary').style.display = 'none';
    return;
  }

  container.innerHTML = qtLines.map((line, idx) => qtRenderLine(line, idx)).join('');
  document.getElementById('qt-summary').style.display = 'block';
  qtUpdateCustomerTypeOptions();
  qtRecalcAll();
}

