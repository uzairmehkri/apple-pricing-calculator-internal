  /* Line item number badge */
  body.light-mode .qt-line-num { color: #636366; }

  /* "Customer Type" label in quotation topbar */
  body.light-mode .qt-topbar span { color: #3c3c43; }

  /* Saved quotes panel */
  body.light-mode .qt-save-slot-name { color: #1c1c1e; }
  body.light-mode .qt-save-slot-meta { color: #636366; }
  body.light-mode .qt-save-slot-empty { color: #636366; }

  /* Search bar: "results-count-text", sort labels */
  body.light-mode #acc-results-count-text,
  body.light-mode #ac-results-count-text  { color: #3c3c43; }

  /* Sub-filter bar labels ("SOURCE:", "TIER:") */
  body.light-mode .sub-filter-bar span { color: #3c3c43; }

  /* Device Search results meta */
  body.light-mode .results-meta { color: #3c3c43; }

  /* No-results text */
