function qtSetPriceMode(id, mode, btn) {
  const line = qtGetLineData(id);
  if (!line) return;
  line.usePriceMode = mode;
  // Update button states in the DOM without full re-render
  const row = btn.closest('.qt-price-mode-toggle');
  if (row) row.querySelectorAll('.qt-pm-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  qtRecalcAll();
}

