function _acAllItems() {
  // Combined indexable list with original indices preserved via _src + _i
  let items = [];
  if (acFilter.source !== 'ace') items = items.concat(CATALOG.applecare.map((x,i) => ({...x, _src: 'AC',  _i: i})));
  if (acFilter.source !== 'ac')  items = items.concat(CATALOG.ace.map((x,i)       => ({...x, _src: 'ACE', _i: i})));
  return items;
}

function renderAcPage() {
  let items = _acAllItems().filter(a => {
    if (acFilter.family !== 'all' && a.family !== acFilter.family) return false;
    if (acFilter.search) {
      const s = acFilter.search.toLowerCase();
      const hay = (a.sku + ' ' + (a.desc||'') + ' ' + a.family + ' ' + a.mrp).toLowerCase();
      if (!s.split(' ').filter(Boolean).every(t => hay.includes(t))) return false;
    }
    return true;
  });
  items = [...items].sort((a, b) => acFilter.sort==='asc' ? a.mrp - b.mrp : b.mrp - a.mrp);

  const total = items.length;
  const totalPages = Math.max(1, Math.ceil(total / ACC_PAGE_SIZE));
  if (acFilter.page >= totalPages) acFilter.page = 0;
  const start = acFilter.page * ACC_PAGE_SIZE;
  const shown = items.slice(start, start + ACC_PAGE_SIZE);

  const countEl = document.getElementById('ac-results-count-text');
  const tableEl = document.getElementById('ac-search-results');
  const paginationEl = document.getElementById('ac-pagination');
  if (!countEl || !tableEl) return;

  const tierLabel = { std:'Std ITP', t1:'Tier 1', t2:'Tier 2', t3:'Tier 3' };
  if (total === 0) countEl.textContent = '0 results';
  else if (totalPages === 1) countEl.textContent = `Showing ${total} plan${total!==1?'s':''} · pricing at ${tierLabel[acFilter.tier]}`;
  else countEl.textContent = `${start+1}–${Math.min(start+ACC_PAGE_SIZE,total)} of ${total} plans · pricing at ${tierLabel[acFilter.tier]}`;

  if (totalPages > 1) {
    paginationEl.style.display = 'flex';
    document.getElementById('ac-page-indicator').textContent = `${acFilter.page+1} / ${totalPages}`;
    document.getElementById('ac-page-prev').disabled = acFilter.page === 0;
    document.getElementById('ac-page-next').disabled = acFilter.page >= totalPages - 1;
  } else if (paginationEl) paginationEl.style.display = 'none';

  if (shown.length === 0) {
    tableEl.innerHTML = '<div class="no-results">No plans match. Try different keywords or clear filters.</div>';
    return;
  }

  const rows = shown.map(a => {
    const fam = (a.family||'Other').toLowerCase().replace(/\s+/g,'');
    const itp = _tierPrice(a, acFilter.tier);
    const tierMissing = (acFilter.tier !== 'std' && !a[acFilter.tier]);
    return `
    <tr>
      <td class="td-type ${fam}">${a.family || 'Other'}</td>
      <td class="td-sku">${a.sku}</td>
      <td class="td-desc">${a.desc || ''} <span style="color:#666;font-size:10px;margin-left:6px">[${a._src}]</span></td>
      <td class="td-mrp">${_fmtR(a.mrp)}</td>
      <td class="td-mrp" style="color:#ffe066">${_fmtR(itp)}${tierMissing?' <span style="color:#666;font-size:9px">(std)</span>':''}</td>
      <td>
        <div style="display:flex;gap:4px">
          <button class="use-btn" data-src="${a._src}" data-i="${a._i}" onclick="useApplecare(this)" title="Open in Calculator">Calc ↗</button>
          <button class="use-btn use-btn-quote" data-src="${a._src}" data-i="${a._i}" onclick="addApplecareToQuote(this)" title="Add to Quotation">+ Quote</button>
        </div>
      </td>
    </tr>`;
  }).join('');

  const cards = shown.map(a => {
    const fam = (a.family||'Other').toLowerCase().replace(/\s+/g,'');
    const itp = _tierPrice(a, acFilter.tier);
    const tierMissing = (acFilter.tier !== 'std' && !a[acFilter.tier]);
    return `
    <div class="device-card">
      <div class="card-top">
        <div class="card-meta">
          <span class="td-type ${fam}" style="font-family:var(--mono);font-size:10px">${a.family || 'Other'}</span>
          <span class="card-sku">${a.sku}</span>
          <span style="font-family:var(--mono);font-size:9px;color:${a._src==='ACE'?'#ffa94d':'#888'}">${a._src}</span>
        </div>
      </div>
      <div class="card-desc">${a.desc || ''}</div>
      <div class="card-bottom">
        <div class="card-mrp"><span style="color:#888;font-size:10px">MRP</span> ${_fmtR(a.mrp)} <span style="color:#888;font-size:10px;margin-left:8px">${tierLabel[acFilter.tier]}</span> <span style="color:#ffe066">${_fmtR(itp)}</span>${tierMissing?' <span style="color:#666;font-size:9px">(std)</span>':''}</div>
        <div style="display:flex;gap:6px">
          <button class="card-use-btn" data-src="${a._src}" data-i="${a._i}" onclick="useApplecare(this)">Calc ↗</button>
          <button class="card-use-btn card-use-btn-quote" data-src="${a._src}" data-i="${a._i}" onclick="addApplecareToQuote(this)">+ Quote</button>
        </div>
      </div>
    </div>`;
  }).join('');

  tableEl.innerHTML = `
    <table class="device-table">
      <thead>
        <tr>
          <th>Family</th>
          <th>SKU</th>
          <th>Plan</th>
          <th style="text-align:right">MRP</th>
          <th style="text-align:right">${tierLabel[acFilter.tier]}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
    <div class="device-cards">${cards}</div>
  `;
}

