  /* ════════════ CTO PRODUCT TOGGLE ════════════ */
  .cto-toggle-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    margin-left: 16px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    user-select: none;
    padding: 4px 10px;
    border: 1px solid var(--border2);
    transition: all 0.15s;
    vertical-align: middle;
  }
  .cto-toggle-wrap:hover { border-color: #555; color: var(--text); }
  .cto-toggle-wrap.active {
    border-color: var(--text);
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }
  .cto-toggle-wrap input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 12px; height: 12px;
    border: 1px solid var(--text3);
    margin: 0;
    padding: 0;
    cursor: pointer;
    display: inline-block;
    position: relative;
    background: transparent;
  }
  .cto-toggle-wrap.active input[type="checkbox"] {
    border-color: var(--text);
    background: var(--text);
  }
  .cto-toggle-wrap.active input[type="checkbox"]::after {
    content: "✓";
    position: absolute;
    top: -3px; left: 1px;
    font-size: 11px;
    color: var(--surface);
    font-weight: 700;
    line-height: 1;
  }

  /* CTO type select — reuse existing select style, just visible only in CTO mode */
  #cto-type-select {
    display: none;
    max-width: 200px;
  }
  body.cto-mode #cto-type-select { display: inline-block; }
  body.cto-mode #product-type-badge { display: none; }

  /* Description field — only visible in CTO mode */
  #cto-desc-field {
    display: none;
  }
  body.cto-mode #cto-desc-field { display: grid; }
  #cto-desc-required-marker {
    color: #ff8585;
    margin-left: 3px;
    font-size: 12px;
  }


  /* ── Quick-copy button ───────────────────────────── */
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: none;
    border: 1px solid var(--border2);
    color: var(--text3);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    padding: 2px 6px;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
    vertical-align: middle;
    margin-left: 6px;
  }
  .copy-btn:hover { color: #fff; border-color: #555; }
  .copy-btn.copied { color: #69db7c; border-color: #69db7c; }

  /* ── Saved quotes panel ──────────────────────────── */
  .qt-saves-panel {
    background: var(--surface2);
    border: 1px solid var(--border2);
    padding: 16px 20px;
    margin: 0;
    display: none;
  }
  .qt-saves-panel.open { display: block; }
  .qt-saves-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .qt-save-slot {
    flex: 1;
    min-width: 160px;
    background: var(--surface3);
    border: 1px solid var(--border2);
    padding: 10px 14px;
    cursor: pointer;
    transition: border-color 0.12s;
  }
  .qt-save-slot:hover { border-color: #555; }
  .qt-save-slot-name {
    font-family: var(--mono);
    font-size: 11px;
    color: #ccc;
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .qt-save-slot-meta {
    font-family: var(--mono);
    font-size: 10px;
    color: #555;
  }
  .qt-save-slot-empty {
    font-family: var(--mono);
    font-size: 10px;
    color: #444;
    font-style: italic;
  }
  .qt-save-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .qt-name-input {
    flex: 1;
    min-width: 140px;
    background: var(--surface3);
    border: 1px solid var(--border2);
    color: var(--text);
    font-family: var(--mono);
    font-size: 11px;
    padding: 6px 10px;
    outline: none;
  }
  .qt-name-input::placeholder { color: #444; }


  /* ══ Light Mode — Apple-crisp ══════════════════════════════════════ */
  body.light-mode {
    --bg:       #f2f2f7;   /* iOS-style system background */
    --surface:  #ffffff;
    --surface2: #f2f2f7;
    --surface3: #e5e5ea;
    --border:   #c6c6c8;
    --border2:  #aeaeb2;
    --text:     #000000;
    --text2:    #1c1c1e;
    --text3:    #636366;
    --accent:   #000000;
    --mac:      #0040dd;   /* high-contrast blue */
    --iphone:   #c00000;   /* high-contrast red  */
    --ipad:     #006b00;   /* high-contrast green */
    --result:   #7d4b00;   /* amber on white      */
    background: var(--bg); color: var(--text);
  }

  /* Header in light mode */
  body.light-mode header {
    background: rgba(242,242,247,0.96);
    border-bottom-color: var(--border);
  }
  body.light-mode .logo { color: #000; }

  /* Tabs */
  body.light-mode .tab { color: #636366; border-color: var(--border); }
  body.light-mode .tab:hover { color: #1c1c1e; border-color: var(--border2); }
  body.light-mode .tab.active { color: #000; background: #fff; border-color: var(--border2); }

  /* Inputs */
  body.light-mode input,
  body.light-mode select,
  body.light-mode textarea {
    background: #fff;
    color: #000;
    border-color: var(--border2);
  }
  body.light-mode input::placeholder { color: #aeaeb2; }

  /* Device search table */
  body.light-mode .device-table th {
    background: #e5e5ea;
    color: #3c3c43;
    border-bottom-color: var(--border2);
  }
  body.light-mode .device-table td { border-bottom-color: var(--border); }
  body.light-mode .device-table tr:hover td { background: #f2f2f7; }

  /* Type column */
  body.light-mode .td-type.mac    { color: #0040dd; font-weight: 600; }
  body.light-mode .td-type.iphone { color: #c00000; font-weight: 600; }
  body.light-mode .td-type.ipad   { color: #006b00; font-weight: 600; }
  body.light-mode .td-type.airpods{ color: #6e3de8; font-weight: 600; }

  /* Type badges (calculator) */
  body.light-mode .type-badge.mac    { color: #0040dd; border-color: #0040dd; background: rgba(0,64,221,0.08); }
  body.light-mode .type-badge.iphone { color: #c00000; border-color: #c00000; background: rgba(192,0,0,0.07); }
  body.light-mode .type-badge.ipad   { color: #006b00; border-color: #006b00; background: rgba(0,107,0,0.07); }

  /* Filter buttons active states */
  body.light-mode .filter-btn { color: #636366; border-color: var(--border); background: #fff; }
  body.light-mode .filter-btn:hover { background: #f2f2f7; color: #1c1c1e; }
  body.light-mode .filter-btn.all.active  { color: #000; border-color: #000; background: #e5e5ea; }
  body.light-mode .filter-btn.mac.active  { color: #0040dd; border-color: #0040dd; background: rgba(0,64,221,0.08); }
  body.light-mode .filter-btn.iphone.active { color: #c00000; border-color: #c00000; background: rgba(192,0,0,0.07); }
  body.light-mode .filter-btn.ipad.active { color: #006b00; border-color: #006b00; background: rgba(0,107,0,0.07); }

  /* SKU + description columns */
  body.light-mode .td-sku  { color: #636366; }
  body.light-mode .td-desc { color: #1c1c1e; }
  body.light-mode .td-mrp  { color: #000; }

  /* Use / Quote buttons */
  body.light-mode .use-btn { color: #1c1c1e; border-color: #aeaeb2; background: #fff; }
  body.light-mode .use-btn:hover { color: #000; border-color: #636366; background: #f2f2f7; }
  body.light-mode .use-btn-quote { color: #7d4b00; border-color: rgba(125,75,0,0.4); background: rgba(125,75,0,0.05); }
  body.light-mode .use-btn-quote:hover { border-color: #7d4b00; background: rgba(125,75,0,0.1); }

  /* Device cards */
  body.light-mode .device-card { background: #fff; border-color: var(--border); }
  body.light-mode .device-card:hover { border-color: var(--border2); }
  body.light-mode .card-sku   { color: #636366; }
  body.light-mode .card-desc  { color: #1c1c1e; }
  body.light-mode .card-mrp   { color: #000; }

  /* Results strip */
  body.light-mode .results-meta  { border-color: var(--border); color: #3c3c43; }
  body.light-mode .sort-btn       { color: #3c3c43; border-color: var(--border); }
  body.light-mode .sort-btn.active{ color: #000; border-color: #000; background: #e5e5ea; }
  body.light-mode .reset-btn      { color: #3c3c43; border-color: var(--border); }
  body.light-mode .reset-btn:hover{ color: #000; border-color: #636366; }

  /* Search bar */
  body.light-mode .search-bar     { background: var(--surface2); border-bottom-color: var(--border); }
  body.light-mode .search-input-wrap { background: #fff; border-color: var(--border2); }
  body.light-mode .search-icon    { color: #aeaeb2; }
  body.light-mode .search-input   { color: #000; }
  body.light-mode .sub-filter-bar { background: #f2f2f7; border-bottom-color: var(--border); }
  body.light-mode .sub-btn        { color: #636366; border-color: var(--border); background: #fff; }
  body.light-mode .sub-btn.active { color: #000; border-color: #000; background: #e5e5ea; }
  body.light-mode .no-results     { color: #636366; }

  /* Pricing calculator */
  body.light-mode .calc-section    { background: #fff; }
  body.light-mode .section-label   { color: #3c3c43; border-bottom-color: var(--border); }
  body.light-mode .field-label     { color: #636366; }
  body.light-mode .result-row      { border-bottom-color: var(--border); }
  body.light-mode .result-label    { color: #636366; }
  body.light-mode .result-value    { color: #000; }
  body.light-mode #r-itp, body.light-mode #r-prog-itp { color: #7d4b00; }
  body.light-mode .margin-positive { color: #006b00 !important; }
  body.light-mode .margin-negative { color: #c00000 !important; }
  body.light-mode .qt-neutral      { color: #3c3c43; }
  body.light-mode .qt-pos          { color: #006b00 !important; }
  body.light-mode .qt-neg          { color: #c00000 !important; }
  body.light-mode .qt-warn         { color: #7d4b00 !important; }
  body.light-mode .panel-topbar    { background: #f2f2f7; border-color: var(--border); }

  /* Quotation */
  body.light-mode .qt-line         { border-bottom-color: var(--border); }
  body.light-mode .qt-line-results { background: #f2f2f7; border-top-color: var(--border); }
  body.light-mode .qt-res-label    { color: #3c3c43; }
  body.light-mode .qt-res-val      { color: #000; }
  body.light-mode .qt-res-val.gold { color: #7d4b00; }
  body.light-mode .qt-res-val.pos  { color: #006b00; }
  body.light-mode .qt-res-val.neg  { color: #c00000; }
  body.light-mode .qt-field-label  { color: #3c3c43; }
  body.light-mode .qt-static       { color: #000; }
  body.light-mode .qt-input        { background: #fff; color: #000; border-color: var(--border2); }
  body.light-mode .qt-select       { background: #fff; color: #000; border-color: var(--border2); }
  body.light-mode .qt-topbar       { border-bottom-color: var(--border); }
  body.light-mode .qt-add-btn      { color: #636366; border-color: var(--border); }
  body.light-mode .qt-add-btn:hover{ color: #000; border-color: #636366; }
  body.light-mode .qt-line-header  { }
  body.light-mode .qt-line-num     { color: #aeaeb2; }
  body.light-mode .qt-line-desc    { color: #1c1c1e; }
  body.light-mode .qt-remove-btn   { color: #aeaeb2; }
  body.light-mode .qt-remove-btn:hover { color: #c00000; }
  body.light-mode .qt-summary      { border-color: var(--border); }
  body.light-mode .qt-sum-header   { background: #e5e5ea; color: #3c3c43; border-bottom-color: var(--border); }
  body.light-mode .qt-sum-grid     { background: var(--border); }
  body.light-mode .qt-sum-section  { background: #fff; }
  body.light-mode .qt-sum-total    { background: #f2f2f7; }
  body.light-mode .qt-sum-label    { color: #3c3c43; }
  body.light-mode .qt-sum-row      { color: #3c3c43; border-bottom-color: var(--border); }
  body.light-mode .qt-sum-row span:last-child { color: #000; }
  body.light-mode .qt-sum-big span:first-child{ color: #3c3c43; }
  body.light-mode .qt-sum-big span:last-child { color: #000; }
  body.light-mode .qt-sum-total-val{ color: #000 !important; }
  body.light-mode .qt-sum-divider  { border-bottom-color: var(--border2) !important; }
  body.light-mode .qt-ac-toggle-row{ border-top-color: var(--border); }
  body.light-mode .qt-ac-label     { color: #3c3c43; }
  body.light-mode .qt-toggle-slider{ border-color: var(--border2); }
  body.light-mode .qt-target-row-label { color: #3c3c43; }
  body.light-mode .qt-saves-panel  { background: #f2f2f7; border-color: var(--border); }
  body.light-mode .qt-save-slot    { background: #fff; border-color: var(--border); }
  body.light-mode .qt-save-slot-name { color: #1c1c1e; }
  body.light-mode .qt-save-slot-meta { color: #636366; }
  body.light-mode .qt-name-input   { background: #fff; color: #000; border-color: var(--border2); }

  /* Breakeven bar */
  body.light-mode .qt-breakeven-bar { background: rgba(192,0,0,0.06); border-color: rgba(192,0,0,0.2); }
  body.light-mode .qt-be-icon       { color: #c00000; }
  body.light-mode .qt-be-msg        { color: #1c1c1e; }

  /* AmpleCare section */
  body.light-mode .ac-header        { background: #f2f2f7; border-color: var(--border); }
  body.light-mode .ac-section-label { color: #1c1c1e; }
  body.light-mode .ac-row-label     { color: #3c3c43; }

  /* GST calc, program header etc */
  body.light-mode .program-header   { background: #f2f2f7; border-color: var(--border); }
  body.light-mode .gst-calc-header  { background: #f2f2f7; border-color: var(--border); }

  /* Copy button */
  body.light-mode .copy-btn         { color: #636366; border-color: var(--border); }
  body.light-mode .copy-btn:hover   { color: #000; border-color: #636366; }
  body.light-mode .copy-btn.copied  { color: #006b00; border-color: #006b00; }

  /* Toast */
  body.light-mode .toast { background: #1c1c1e; color: #fff; }

  /* Accessories/AppleCare search */
  body.light-mode .search-input-wrap input { color: #000; }

  /* ── Light mode: ALL labels, titles, headers — crisp & high contrast ── */

  /* Panel topbar titles ("PRICING CALCULATOR", "DEAL QUOTATION", etc.) */
  body.light-mode .panel-topbar-title { color: #1c1c1e; }
  body.light-mode .panel-topbar { background: #f2f2f7; border-color: var(--border); }

  /* Quotation topbar title ("▸ DEAL QUOTATION") */
  body.light-mode .qt-title { color: #1c1c1e; }

  /* Calculator section labels (uppercase dividers: "ITP", "MARGIN", etc.) */
  body.light-mode .section-label { color: #1c1c1e; border-bottom-color: var(--border); }

  /* Calculator field labels (left column: "SKU", "MRP", "Type", "BE %", etc.) */
  body.light-mode .field-label { color: #3c3c43; }

  /* Calculator result labels ("ITP (per unit)", "Selling Price", etc.) */
  body.light-mode .result-label { color: #3c3c43; }

  /* Calculator result amounts (the big numbers) */
  body.light-mode .result-amount { color: #7d4b00; }
  body.light-mode .result-amount.dim { color: #3c3c43; }

  /* Margin builder / checker labels */
  body.light-mode .margin-result-label { color: #3c3c43; }
  body.light-mode .margin-result-val   { color: #1c1c1e; }

  /* AmpleCare field labels ("AmpleCare Rate", "AmpleCare ITP", etc.) */
  body.light-mode .ac-field-label   { color: #3c3c43; }
  body.light-mode .ac-section-label { color: #1c1c1e; }
  body.light-mode .ac-row-label     { color: #3c3c43; }
  body.light-mode .ac-info-val      { color: #1c1c1e; }

  /* GST calculator */
  body.light-mode .gst-calc-header      { color: #1c1c1e; background: #f2f2f7; border-color: var(--border); }
  body.light-mode .gst-calc-panel-label { color: #3c3c43; }
  body.light-mode .gst-calc-result-label{ color: #3c3c43; }
  body.light-mode .gst-calc-result-val  { color: #7d4b00; }
  body.light-mode .gst-calc-rate-row    { color: #636366; }

  /* Quotation field labels ("SKU", "MRP", "QTY", "BE %", "MARGIN %", etc.) */
  body.light-mode .qt-field-label { color: #3c3c43; }

  /* Quotation result strip labels ("ITP (per unit)", "HW Margin", etc.) */
  body.light-mode .qt-res-label { color: #3c3c43; }

  /* Customer Target label */
  body.light-mode .qt-target-row-label { color: #3c3c43; }

  /* AC toggle: "AmpleCare / AppleCare+" label */
  body.light-mode .qt-ac-label { color: #1c1c1e; }
  body.light-mode .ac-mode-pill { color: #3c3c43; border-color: var(--border2); }
  body.light-mode .ac-mode-pill.active-amplecare { color: #7d4b00; border-color: #7d4b00; background: rgba(125,75,0,0.07); }
  body.light-mode .ac-mode-pill.active-applecare { color: #0040dd; border-color: #0040dd; background: rgba(0,64,221,0.07); }
  body.light-mode .qt-apc-tier-btn { color: #3c3c43; border-color: var(--border2); }
  body.light-mode .qt-apc-tier-btn.active { color: #7d4b00; border-color: #7d4b00; background: rgba(125,75,0,0.07); }

  /* Deal summary: section labels ("HARDWARE", "AMPLECARE", "OVERALL DEAL") */
  body.light-mode .qt-sum-label { color: #1c1c1e; border-bottom-color: var(--border); }

  /* Deal summary row labels ("HW ITP", "Total Revenue", "Deal Margin %", etc.) */
  body.light-mode .qt-sum-row      { color: #3c3c43; border-bottom-color: var(--border); }
  body.light-mode .qt-sum-row span:last-child { color: #000; font-weight: 600; }
  body.light-mode .qt-sum-big span:first-child { color: #3c3c43; }
  body.light-mode .qt-sum-big span:last-child  { color: #000; }

  /* BE Recovery section labels */
  body.light-mode #qs-be-recovery-section      { border-top-color: var(--border2); }
