// ── PERSISTENCE (localStorage) ────────────────────────────────────────────
const LS_NAMED  = 'ample_qt_named';  // array of up to 5 named saves
const LS_THEME  = 'ample_qt_theme';  // future: theme preference

// Serialise the current quote state
function qtSerialise() {
  return {
    lines: JSON.parse(JSON.stringify(qtLines)),
    nextId: qtNextId,
    customerType: document.getElementById('qt-customer-type')?.value ?? 'non-crt',
    savedAt: Date.now()
  };
}

// Restore a serialised state
function qtRestore(state) {
  if (!state || !Array.isArray(state.lines)) return;
  qtLines  = state.lines;
  qtNextId = state.nextId ?? (Math.max(0, ...state.lines.map(l => l.id)) + 1);
  const sel = document.getElementById('qt-customer-type');
  if (sel && state.customerType) {
    // ensure option exists
    const opt = [...sel.options].find(o => o.value === state.customerType);
    if (!opt) {
      const o = document.createElement('option');
      o.value = state.customerType;
      o.textContent = state.customerType;
      sel.appendChild(o);
    }
    sel.value = state.customerType;
    qtOnCustomerTypeChange();
  }
  qtRender();
}

// Auto-save on every change (throttled 800ms)

// Restore auto-saved state on page load

// Named save: up to 5 slots
function getNamedSaves() {
  try { return JSON.parse(localStorage.getItem(LS_NAMED) || '[]'); } catch(e) { return []; }
}
function setNamedSaves(arr) {
  try { localStorage.setItem(LS_NAMED, JSON.stringify(arr)); } catch(e) {}
}

function saveNamedQuote() {
  if (qtLines.length === 0) { showToast('Nothing to save — add a device first'); return; }
  const inp = document.getElementById('qt-save-name');
  const name = (inp?.value?.trim()) || ('Quote ' + new Date().toLocaleDateString('en-IN'));
  inp.value = '';
  const saves = getNamedSaves();
  const slot = { name, state: qtSerialise() };
  saves.unshift(slot);
  if (saves.length > 5) saves.length = 5;
  setNamedSaves(saves);
  renderSavesGrid();
  showToast('Saved "' + name + '"');
}

function saveAutoQuote() {
  showToast('Auto-saved ✓');
}

function loadNamedQuote(idx) {
  const saves = getNamedSaves();
  if (!saves[idx]) return;
  if (qtLines.length > 0 && !confirm('Load "' + saves[idx].name + '"? Current quote will be replaced.')) return;
  qtRestore(saves[idx].state);
  showToast('Loaded "' + saves[idx].name + '"');
  toggleSavesPanel(true); // close panel
}

function deleteNamedQuote(idx) {
  const saves = getNamedSaves();
  saves.splice(idx, 1);
  setNamedSaves(saves);
  renderSavesGrid();
}

function renderSavesGrid() {
  const grid = document.getElementById('qt-saves-grid');
  if (!grid) return;
  const saves = getNamedSaves();
  if (saves.length === 0) {
    grid.innerHTML = '<div class="qt-save-slot-empty" style="padding:8px;color:#444;font-family:var(--mono);font-size:11px;">No saved quotes yet. Add devices and click ↓ Save current.</div>';
    return;
  }
  grid.innerHTML = saves.map((s, i) => {
    const d = new Date(s.state.savedAt);
    const ds = d.toLocaleDateString('en-IN', { day:'2-digit', month:'short' }) + ' ' + d.toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' });
    const lines = s.state.lines?.length ?? 0;
    return `<div class="qt-save-slot">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div onclick="loadNamedQuote(${i})" style="flex:1">
          <div class="qt-save-slot-name">${s.name}</div>
          <div class="qt-save-slot-meta">${lines} line${lines!==1?'s':''} · ${ds}</div>
        </div>
        <button onclick="deleteNamedQuote(${i})" style="background:none;border:none;color:#555;cursor:pointer;font-size:14px;padding:0 0 0 8px" title="Delete">✕</button>
      </div>
    </div>`;
  }).join('');
}

function toggleSavesPanel(forceClose) {
  const panel = document.getElementById('qt-saves-panel');
  if (!panel) return;
  const isOpen = panel.classList.contains('open');
  if (forceClose || isOpen) {
    panel.classList.remove('open');
  } else {
    renderSavesGrid();
    panel.classList.add('open');
  }
}

