// ── State ────────────────────────────────────────────────────
let accFilter = { family: 'all', search: '', sort: 'asc', page: 0 };
let acFilter  = { family: 'all', tier: 'std', search: '', source: 'both', sort: 'asc', page: 0 };
const ACC_PAGE_SIZE = 50;

// ── Helpers ──────────────────────────────────────────────────
function _fmtR(n) { return '₹' + Math.round(n||0).toLocaleString('en-IN'); }

// Pick the price for a tier; falls back to ITP if tier price is missing
function _tierPrice(item, tier) {
  if (tier === 't1' && item.t1) return item.t1;
  if (tier === 't2' && item.t2) return item.t2;
  if (tier === 't3' && item.t3) return item.t3;
  return item.itp;
}

// Compute ITP from (MRP-tax) - FD%; account for minor rounding by trusting the catalog's stored ITP
function _accITP(item) { return item.itp; }

// ── Render Accessories tab (mirrors Device Search) ───────────
function renderAccessoriesTab() {
  const panel = document.getElementById('tab-accessories'); if (!panel) return;
  panel.innerHTML = `
    <div style="background:var(--border)">
      <div class="search-bar">
        <div class="search-input-wrap">
