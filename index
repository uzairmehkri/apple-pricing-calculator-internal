function qtUpdateCustomerTypeOptions() {
  // Determine dominant device type in the quote (handle CTO lines)
  const types = new Set(qtLines.map(l => {
    if (l.isCto) return l.customType || null;
    const d = DEVICES.find(dev => dev.sku === l.sku);
    return d ? d.type : null;
  }).filter(Boolean));

  // Pick a single context: Mac > iPad > iPhone > null
  let ctx = null;
  if (types.has('Mac'))    ctx = 'Mac';
  else if (types.has('iPad'))  ctx = 'iPad';
  else if (types.has('iPhone')) ctx = 'iPhone';

  setDropdownByType('qt-customer-type', ctx);
}

function qtGetCustomerTypeRate(deviceType) {
  const sel = document.getElementById('qt-customer-type');
  if (!sel) return 0;
  const rates = CUSTOMER_TYPE_RATES[sel.value];
  if (!rates) return 0;
  const key = deviceType ? deviceType.toLowerCase() : null;
  if (key === 'mac') return rates.mac ?? 0;
  if (key === 'ipad') return rates.ipad ?? 0;
  if (key === 'iphone') return rates.iphone ?? 0;
  return 0;
}

